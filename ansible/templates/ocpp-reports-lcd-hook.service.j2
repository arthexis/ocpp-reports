[Unit]
Description=OCPP Reports read-only LCD/Sound status hook
After=network-online.target ocpp-reports-ingest.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
StateDirectory=ocpp-reports-lcd
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/bin/ocpp-reports lcd-hook --database /var/lib/ocpp-reports/warehouse.sqlite --state /var/lib/ocpp-reports-lcd/hook-state.json --lcd /home/ubuntu/.local/bin/lcd --sound /home/ubuntu/.local/bin/sound --interval 30
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/ocpp-reports-lcd
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
