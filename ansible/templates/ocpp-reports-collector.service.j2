[Unit]
Description=OCPP Reports Collector
After=network.target

[Service]
Type=simple
User=ocpp-reports
Group=ocpp
ExecStart={{ reports_cli_link }} collect --database /var/lib/ocpp-reports/warehouse.sqlite --credentials-file /etc/ocpp-reports/collector.toml --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
