# Managed by ocpp-reports: replication API only.
server {
    listen 443 ssl;
    server_name {{ reports_collector_hostname }};
    ssl_certificate {{ reports_collector_certificate }};
    ssl_certificate_key {{ reports_collector_private_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    client_max_body_size 2m;

    location = /api/replication {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location = /api/diagnostics {
        limit_except POST { deny all; }
        client_max_body_size 100m;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Authorization $http_authorization;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
    location / { return 404; }
}
server {
    listen 80;
    server_name {{ reports_collector_hostname }};
    return 301 https://$host$request_uri;
}
