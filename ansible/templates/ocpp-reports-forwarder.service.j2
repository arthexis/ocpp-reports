[Unit]
Description=OCPP Reports Forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ocpp-reports
Group=ocpp
ExecStart={{ reports_cli_link }} forward --database /var/lib/ocpp-reports/warehouse.sqlite --state /var/lib/ocpp-reports/forwarder.sqlite --config /etc/ocpp-reports/forwarder.toml
Restart=on-failure
RestartSec=60
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
