[Unit]
Description=OCPP Reports Dashboard
After=network.target

[Service]
Type=simple
User=ocpp-reports
Group=ocpp
ExecStart={{ reports_cli_link }} serve --database /var/lib/ocpp-reports/warehouse.sqlite --host 127.0.0.1 --port 8080{% for zone in reports_dashboard_timezones | default([]) %} --timezone {{ zone | quote }}{% endfor +%}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
