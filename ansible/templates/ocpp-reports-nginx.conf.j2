# Managed by ocpp-reports. TLS and operator credentials are provisioned externally.
server {
    listen 443 ssl;
    server_name {{ reports_nginx_server_name }};

    ssl_certificate {{ reports_nginx_certificate }};
    ssl_certificate_key {{ reports_nginx_private_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    client_max_body_size 2m;

    # Replication authenticates with source-scoped bearer tokens at the Collector.
    # Do not apply dashboard Basic Auth to this endpoint.
    location = /api/replication {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # All dashboard routes (including APIs) require operator Basic Auth.
    location / {
        auth_basic "OCPP Reports";
        auth_basic_user_file {{ reports_nginx_htpasswd }};
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 80;
    server_name {{ reports_nginx_server_name }};
    return 301 https://$host$request_uri;
}
