# Managed by ocpp-reports: customer dashboard only.
server {
    listen 443 ssl;
    server_name {{ reports_dashboard_hostname }};
    ssl_certificate {{ reports_dashboard_certificate }};
    ssl_certificate_key {{ reports_dashboard_private_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    location / {
        auth_basic "OCPP Reports";
        auth_basic_user_file {{ reports_nginx_htpasswd }};
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
server {
    listen 80;
    server_name {{ reports_dashboard_hostname }};
    return 301 https://$host$request_uri;
}
