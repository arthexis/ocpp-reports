<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ 'Conector ' ~ selected_connector_id if selected_connector_id is not none else 'Cargador' }} · {{ charger_id }} · {{ title }}</title>
<style>
/* Reuse the same Reports dashboard palette, header, cards and responsive tables. */
:root{color-scheme:light;--bg:#f5f7fa;--surface:#fff;--ink:#172437;--muted:#637286;--line:#e2e8f0;--nav:#203247;--accent:#1268c7;--warning:#a96700;font:16px system-ui,sans-serif}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);line-height:1.45}
a{color:var(--accent)}a:focus-visible,summary:focus-visible,button:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
header{background:var(--nav);color:white;padding:1.2rem max(1.25rem,calc((100vw - 1280px)/2));display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
header h1{font-size:1.45rem;margin:0}header .note{color:#d0dbe6}
.back-link{color:#fff;border:1px solid #718096;border-radius:8px;min-height:44px;display:inline-flex;align-items:center;padding:.5rem .75rem;text-decoration:none;font-weight:600}
main{max-width:1320px;margin:auto;padding:1.4rem 1.25rem 3rem}
section{margin:0 0 1.25rem;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:1.25rem;box-shadow:0 2px 10px #152c4608}
section h2{font-size:1.05rem;margin:0 0 1rem}.note{font-size:.82rem}.muted{color:var(--muted)}.identity{font-size:1.5rem;margin:.1rem 0 .35rem;overflow-wrap:anywhere}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.grid>*{min-width:0}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.75rem;margin:1rem 0}
.stat{border:1px solid var(--line);border-radius:9px;background:var(--bg);padding:.85rem;min-width:0}
.stat strong{display:block;font-size:1.1rem;overflow-wrap:anywhere}.stat .note{color:var(--muted)}
.connector-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:.75rem}
.connector{border:1px solid var(--line);border-radius:10px;padding:1rem;background:var(--surface);min-width:0}
.connector h3{margin:0 0 .6rem;font-size:1rem}.connector dl{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.4rem .65rem;font-size:.85rem;margin:0}
dt{color:var(--muted)}dd{margin:0;overflow-wrap:anywhere}.scroll{overflow:auto;max-width:100%}
table{width:100%;border-collapse:collapse;font-size:.87rem}th,td{padding:.72rem .65rem;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}
th{background:#f6f8fb;color:#34455a;font-weight:650}td.numeric{text-align:right;font-variant-numeric:tabular-nums}
.empty{text-align:center;color:var(--muted);padding:1.5rem}
.status{display:inline-flex;align-items:center;gap:.35rem;padding:.2rem .5rem;border-radius:999px;font-size:.84rem;font-weight:650;background:#edf1f5}
.status::before{content:"";width:.5rem;height:.5rem;border-radius:50%;background:#8795a7}
.status--ok{background:#e3f6ed;color:#087342}.status--ok::before{background:#0b9960}
.status--active{background:#e4f0ff;color:#155bad}.status--active::before{background:#1976e9}
.status--warn{background:#fff3d9;color:#906000}.status--warn::before{background:#dfa000}
.status--off{background:#f7e8e8;color:#984545}.status--off::before{background:#c55b5b}
.event-group{border:0;margin:0;padding:0}
.event-group summary{cursor:pointer;padding:.05rem 0;color:var(--accent);font-weight:600;overflow-wrap:anywhere}
.event-group summary:hover{text-decoration:underline;text-underline-offset:2px}
.event-detail{margin:.45rem 0}.event-expand-row td{padding:.05rem .65rem .5rem}
.event-expand-row[hidden]{display:none}
.events-table td{white-space:normal}.events-table th,.events-table td{vertical-align:top}
.events-table .event-summary-row td{padding-top:.55rem;padding-bottom:.55rem}
.events-table .event-action{overflow-wrap:anywhere}
.events-table .event-detail .scroll{overflow-x:auto;max-width:100%}
.energy-overview{margin:0 0 .7rem}.energy-overview strong{font-size:1.4rem;font-variant-numeric:tabular-nums}
.energy-heading{display:flex;justify-content:space-between;align-items:center;gap:.35rem .65rem;flex-wrap:wrap;margin-bottom:.55rem}
.energy-heading h2{margin:0}
.energy-heading-title{display:flex;align-items:center;gap:.15rem;min-width:0}
.energy-help-trigger{background:transparent;color:var(--muted);border:0;padding:.2rem;min-width:38px;min-height:38px;border-radius:50%;font-weight:600;font-size:1.15rem}
.energy-help-trigger:hover{color:var(--accent)}
.energy-help[hidden],.energy-legend[hidden]{display:none}
.energy-help{padding:.65rem .8rem;border:1px solid var(--line);border-radius:8px;background:var(--bg);font-size:.83rem;margin:0 0 .7rem}
.energy-controls{display:flex;flex:0 1 26rem;align-items:center;justify-content:flex-end;gap:.35rem;flex-wrap:nowrap;min-width:0}
.energy-legend{display:flex;align-items:center;gap:.65rem;flex-wrap:wrap;margin:-.2rem 0 .7rem}
.energy-legend-item{display:inline-flex;align-items:center;gap:.3rem;font-size:.8rem;color:var(--muted)}
.energy-legend-swatch{height:.65rem;width:.75rem;border-radius:2px;background:var(--connector-a)}
.energy-legend-swatch.connector-color-1{background:var(--connector-b)}
.energy-legend-swatch.connector-color-2{background:var(--connector-c)}
.energy-legend-swatch.connector-color-3{background:var(--connector-d)}
.energy-range{flex:1 1 0;min-width:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch;gap:.2rem}
.energy-range button{min-width:0;width:100%;min-height:40px;padding-block:.35rem;padding-inline:0;border:1px solid var(--line);border-radius:8px;background:transparent;color:var(--ink);font-size:.86rem;font-weight:600;white-space:nowrap}
.energy-range button[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:#fff}
:root{--connector-a:#0072b2;--connector-b:#d55e00;--connector-c:#009e73;--connector-d:#885bb9}
.energy-days[data-view="total"] .energy-connector-bars{display:none}
.energy-days[data-view="connectors"] .energy-bar{display:none}
.energy-connector-bars{display:flex;align-items:flex-end;gap:1px;min-width:0;width:100%;height:100%}
.energy-connector-bar{display:block;min-width:0;flex:1 1 0;height:var(--connector-height-7);border-radius:2px 2px 0 0;background:var(--connector-a)}
.energy-connector-bar.connector-color-1{background:var(--connector-b)}
.energy-connector-bar.connector-color-2{background:var(--connector-c)}
.energy-connector-bar.connector-color-3{background:var(--connector-d)}
.energy-days[data-days="30"] .energy-connector-bar{height:var(--connector-height-30)}
.energy-days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));column-gap:.45rem;width:100%;min-width:0;max-width:100%;overflow:hidden;border-bottom:1px solid var(--line);padding:0 0 .25rem}
.energy-days[data-days="30"]{grid-template-columns:repeat(30,minmax(0,1fr));column-gap:.13rem}
.energy-day{min-width:0;display:grid;grid-template-rows:clamp(110px,18vw,180px) 1.25rem;gap:.3rem}
.energy-days[data-days="7"] .energy-older{display:none}
.energy-column{display:flex;align-items:flex-end;min-width:0;height:100%}
.energy-bar{display:block;width:100%;min-height:0;height:var(--energy-height-7);background:var(--accent);border-radius:3px 3px 0 0}
.energy-days[data-days="30"] .energy-bar{height:var(--energy-height-30)}
.energy-date{min-width:0;white-space:nowrap;text-align:center;font-size:.7rem;color:var(--muted)}
.energy-days[data-days="30"] .energy-date-7{display:none}
.energy-axis-labels{display:none;width:100%;min-width:0;justify-content:space-between;gap:.1rem;font-size:.65rem;color:var(--muted);white-space:nowrap;padding-top:.22rem}
.energy-days[data-days="30"] + .energy-axis-labels{display:flex}
@media(max-width:520px){.energy-day{grid-template-rows:135px 1.25rem}.energy-days{column-gap:.2rem}.energy-days[data-days="30"]{column-gap:1px}.energy-range button{min-height:38px;padding:.25rem .48rem}.energy-date{font-size:.63rem}
.energy-heading{align-items:center;flex-wrap:nowrap;gap:.15rem}
.energy-heading-title{gap:0;flex:0 0 auto}
.energy-heading h2{font-size:.9rem}
.energy-help-trigger{min-width:25px;min-height:34px;padding:0;font-size:1rem}
.energy-controls{flex:0 1 16.5rem;justify-content:flex-end;flex-wrap:nowrap;gap:1px}
.energy-range{gap:1px}
.energy-range button{font-size:.65rem;min-height:36px;padding-block:.2rem;padding-inline:0;border-radius:5px;letter-spacing:-.15px}
#energy-30-days{padding:.85rem .55rem}
.connector dd{font-size:1.04rem;line-height:1.3}
.connector dd .status{font-size:.96rem}
.energy-connector-bars{gap:0}}
@media(max-width:350px){
.energy-heading h2{font-size:.86rem}
.energy-range button{font-size:.56rem;padding-block:.15rem;padding-inline:0;letter-spacing:-.25px}
.energy-help-trigger{min-width:23px}
}
@media(max-width:520px){
  .sessions-table .session-start,.sessions-table .session-duration{display:none}
  .sessions-table th,.sessions-table td{padding:.48rem .28rem}
  .events-table{min-width:0;max-width:100%;table-layout:fixed;font-size:.77rem}
  .events-table th,.events-table td{padding:.5rem .24rem;white-space:normal;overflow-wrap:anywhere}
  .events-table .event-action summary{max-width:100%;overflow-wrap:anywhere;word-break:break-word}
  .events-table .event-id{display:none}
  .events-table .event-action{width:44%}
  .events-table .event-date{width:39%}
  .events-table .event-count{width:17%}
  .events-table .event-expand-row td{padding:.35rem .18rem}
}
.pages{display:flex;gap:.7rem;align-items:center;justify-content:flex-end;margin-top:1rem;flex-wrap:wrap}
.pages a,.pages span{padding:.35rem .65rem;border:1px solid var(--line);border-radius:7px}
button{background:var(--accent);color:white;border:0;border-radius:8px;cursor:pointer;padding:.55rem .8rem;min-height:44px;font:inherit}
@media(max-width:800px){.grid{grid-template-columns:1fr}main{padding:1rem .75rem}section{padding:1rem}header{padding:1rem}}
@media(max-width:520px){.connector-list{grid-template-columns:1fr}header h1{font-size:1.12rem}table{font-size:.78rem}th,td{padding:.55rem .45rem}}
@media(prefers-color-scheme:dark){:root{color-scheme:dark;--bg:#111923;--surface:#1b2734;--ink:#e8eef6;--muted:#a5b3c3;--line:#344557;--nav:#0c1520;--accent:#5da5f5;--warning:#ffbe60}th{background:#263647;color:#d7e5f5}.status{background:#354657;color:#e1e9f3}}
</style></head><body>
<a class="back-link" style="position:absolute;left:1rem;top:-5rem" href="#content">Ir al contenido</a>
<header><div><h1>{{ title }}</h1><div class="note">Solo lectura · {{ timezone }}</div></div>
<div><a class="back-link" href="/?tz={{ timezone|urlencode }}#connectors">← Dashboard</a>
{% if selected_connector_id is not none %}<a class="back-link" href="/chargers/{{ source_id|urlencode }}/{{ charger_id|urlencode }}?tz={{ timezone|urlencode }}">Cargador completo</a>{% endif %}</div></header>
<main id="content">
<section aria-labelledby="device-title"><h2 class="identity" id="device-title">{% if selected_connector_id is none %}Cargador {{ charger_id }}{% else %}Cargador {{ charger_id }} · Conector {{ selected_connector_id }}{% endif %}</h2>
<p class="muted">{{ location }} · Origen {{ source_id }}</p>
<div class="stats"><div class="stat"><span class="note">Sesiones registradas</span><strong>{{ tx_total }}</strong></div>
<div class="stat"><span class="note">Conectores visibles</span><strong>{{ physical_connector_count }}</strong></div>
<div class="stat"><span class="note">Último Heartbeat</span><strong>{{ heartbeat_at|display_date(timezone) if heartbeat_at else 'Sin fecha' }}</strong></div>
<div class="stat"><span class="note" title="Último mensaje OCPP registrado por el CSMS para este cargador; no es la fecha de importación del origen">Último recibo</span><strong>{{ receipt_at|display_date(timezone) if receipt_at else 'Sin fecha' }}</strong></div></div>
</section>
{% if selected_connector_id is none %}
<section id="energy-30-days" aria-labelledby="energy-30-title">
<div class="energy-heading">
<div class="energy-heading-title"><h2 id="energy-30-title">Energía</h2>
<button class="energy-help-trigger" type="button" aria-label="Información sobre energía" aria-expanded="false" aria-controls="energy-help">ⓘ</button>
</div>
<div class="energy-controls">
<div class="energy-range" role="group" aria-label="Periodo de energía">
<button type="button" data-energy-days="7" aria-label="7 días" aria-pressed="true">7 días</button>
<button type="button" data-energy-days="30" aria-label="30 días" aria-pressed="false">30 días</button>
</div>
<div class="energy-range" role="group" aria-label="Desglose de energía">
<button type="button" data-energy-view="total" aria-pressed="true">Estación</button>
<button type="button" data-energy-view="connectors" aria-pressed="false">Conectores</button>
</div></div></div>
<p class="energy-help" id="energy-help" hidden>La energía es la suma de las sesiones cerradas por fecha local de finalización ({{ timezone }}). Estación agrega los conectores físicos; Conectores muestra cada uno por separado. C0 es un medidor/resumen de estación y no se suma otra vez. No incluye sesiones activas ni estima períodos faltantes.</p>
<div class="energy-overview" aria-live="polite">
<strong id="energy-total" data-total-7="{{ '%.2f'|format(energy_30_days.last_7.total_kwh) }}" data-total-30="{{ '%.2f'|format(energy_30_days.total_kwh) }}">{{ '%.2f'|format(energy_30_days.last_7.total_kwh) }} kWh</strong>
<span class="muted note" id="energy-sessions" data-count-7="{{ energy_30_days.last_7.sessions_count }}" data-count-30="{{ energy_30_days.sessions_count }}">· {{ energy_30_days.last_7.sessions_count }} sesiones cerradas</span>
</div>
<div class="energy-legend" id="energy-legend" hidden aria-label="Colores de los conectores">
{% for id in energy_30_days.connector_ids %}
<span class="energy-legend-item"><span class="energy-legend-swatch connector-color-{{ loop.index0 % 4 }}" aria-hidden="true"></span>C{{ id }}</span>
{% else %}<span class="note muted">Sin sesiones de conectores físicos en el periodo.</span>{% endfor %}
</div>
<div id="energy-chart" class="energy-days" data-days="7" data-view="total" role="list" aria-label="Energía total entregada por día, últimos 7 días, {{ timezone }}">
{% for bar in energy_30_days.bars %}
<div class="energy-day{{ ' energy-older' if loop.index0 < 23 else '' }}" role="listitem" aria-label="{{ bar.day }}: {{ '%.2f'|format(bar.kwh) }} kWh, {{ bar.sessions }} sesiones" data-total-description="{{ bar.day }}: {{ '%.2f'|format(bar.kwh) }} kWh, {{ bar.sessions }} sesiones" data-connector-description="{{ bar.day }}: {{ bar.connector_description or 'Sin mediciones por conector' }}" title="{{ bar.day }}: {{ '%.2f'|format(bar.kwh) }} kWh · {{ bar.sessions }} sesiones">
<div class="energy-column">
<span class="energy-bar" style="--energy-height-7:{{ bar.height_pct_7 }}%;--energy-height-30:{{ bar.height_pct_30 }}%"></span>
<span class="energy-connector-bars">
{% for c in bar.connectors %}
<span class="energy-connector-bar connector-color-{{ loop.index0 % 4 }}" style="--connector-height-7:{{ c.height_pct_7 }}%;--connector-height-30:{{ c.height_pct_30 }}%" title="C{{ c.id }} · {{ bar.day }}: {{ '%.2f'|format(c.kwh) }} kWh, {{ c.sessions }} sesiones"></span>
{% endfor %}
</span>
</div>
<span class="energy-date energy-date-7">{{ bar.label_7 or '' }}</span>
</div>
{% endfor %}
</div>
<div class="energy-axis-labels" aria-hidden="true">{% for bar in energy_30_days.bars %}{% if bar.label %}<span>{{ bar.label }}</span>{% endif %}{% endfor %}</div>
</section>
{% endif %}
<section aria-labelledby="connector-title"><h2 id="connector-title">{{ 'Conector' if selected_connector_id is not none else 'Conectores del cargador' }}</h2>
<div class="connector-list">{% for c in connectors %}
<article class="connector"><h3>{% if selected_connector_id is none %}<a href="/connectors/{{ source_id|urlencode }}/{{ charger_id|urlencode }}/{{ c.connector_id }}?tz={{ timezone|urlencode }}">{{ 'Estación (C0)' if c.connector_id == 0 else 'Conector ' ~ c.connector_id }}</a>{% else %}Conector {{ c.connector_id }}{% endif %}</h3>
<dl>
<dt>Estado informado</dt><dd>{% set state = (c.status or '')|lower %}<span class="status {{ 'status--off' if state in ['faulted','unavailable'] else 'status--active' if state == 'charging' and not c.stale else 'status--ok' if state in ['available','finishing'] and not c.stale else 'status--warn' if state in ['preparing','suspendedev','suspendedevse'] else '' }}">{{ c.status or 'Desconocido' }}</span></dd>
<dt>Potencia</dt><dd>{% if c.power_fresh and c.power_w is not none %}{{ '%.2f'|format(c.power_w / 1000) }} kW <span class="note muted">medida</span>{% elif c.rated_power_w is defined and c.rated_power_w is not none %}{{ '%.2f'|format(c.rated_power_w / 1000) }} kW <span class="note muted">nominal (no medida)</span>{% else %}No disponible{% endif %}</dd>
<dt>Medidor acumulado</dt><dd>{{ '%.2f'|format(c.energy_wh / 1000) ~ ' kWh' if c.energy_wh is not none else '—' }}</dd>
<dt>Medición de energía</dt><dd>{{ c.energy_observed_at|display_date(timezone) if c.energy_observed_at else 'Sin fecha' }}</dd>
{% if c.active_transaction_id is not none %}<dt>Sesión actual</dt><dd><a href="/transactions/{{ source_id|urlencode }}/{{ charger_id|urlencode }}/{{ c.active_transaction_id }}?tz={{ timezone|urlencode }}">#{{ c.active_transaction_id }}</a></dd>{% endif %}
</dl></article>
{% else %}<p class="muted">Sin estado de conectores registrado; consulta las sesiones históricas.</p>{% endfor %}</div>
</section>
<section id="transactions" aria-labelledby="transactions-title"><h2 id="transactions-title">Sesiones de carga</h2>
<div class="scroll" role="region" tabindex="0" aria-label="Sesiones de este {{ 'conector' if selected_connector_id is not none else 'cargador' }}">
<table class="sessions-table"><thead><tr>{% if selected_connector_id is none %}<th>Conector</th>{% endif %}<th>ID</th><th>Estado</th><th class="session-start">Inicio</th><th>Fin</th><th class="session-duration">Duración</th><th>Energía de sesión</th></tr></thead><tbody>
{% for t in data.transactions %}<tr>{% if selected_connector_id is none %}<td><a href="/connectors/{{ source_id|urlencode }}/{{ charger_id|urlencode }}/{{ t.connector_id }}?tz={{ timezone|urlencode }}">{{ t.connector_id if t.connector_id is not none else '—' }}</a></td>{% endif %}
<td><a href="/transactions/{{ source_id|urlencode }}/{{ charger_id|urlencode }}/{{ t.id }}?tz={{ timezone|urlencode }}">{{ t.id }}</a></td>
<td>{{ t.state or 'Desconocido' }}</td><td class="session-start">{{ t.started_at|display_date(timezone) }}</td><td>{{ t.stopped_at|display_date(timezone) if t.stopped_at else 'Activa / sin cierre' }}</td>
<td class="session-duration">{{ t.started_at|session_duration(t.stopped_at) }}</td>
<td class="numeric">{{ '%.2f'|format(t.energy_wh / 1000) ~ ' kWh' if t.energy_wh is not none else 'En curso / pendiente' if t.active else '—' }}</td></tr>
{% else %}<tr><td class="empty" colspan="{{ 7 if selected_connector_id is none else 6 }}">Sin sesiones</td></tr>{% endfor %}
</tbody></table></div>
<nav class="pages" aria-label="Páginas de sesiones">
<span class="note muted">{{ ((tx_page - 1) * 20 + 1) if tx_total else 0 }}–{{ [tx_page * 20, tx_total]|min }} de {{ tx_total }}</span>
{% if tx_page > 1 %}<a rel="prev" href="{{ request.url.include_query_params(tx_page=tx_page-1) }}#transactions">Anterior</a>{% endif %}
<span aria-current="page">{{ tx_page }} / {{ tx_pages }}</span>
{% if tx_page < tx_pages %}<a rel="next" href="{{ request.url.include_query_params(tx_page=tx_page+1) }}#transactions">Siguiente</a>{% endif %}
</nav></section>
{% if selected_connector_id is none %}
<section id="events" aria-labelledby="events-title"><h2 id="events-title">Eventos registrados de {{ charger_id }}</h2>
<div class="scroll" tabindex="0" role="region" aria-label="Eventos registrados de este cargador">
<table class="events-table"><thead><tr><th class="event-id">ID</th><th class="event-action">Acción</th><th class="event-date">Fecha</th><th class="event-count">Registros</th></tr></thead>
<tbody id="live-event-groups">
{% for group in event_groups %}
<tr class="event-summary-row"><td class="event-id">{{ group.first_event_id }}</td>
<td class="event-action"><details class="event-group" data-source="{{ group.source_id }}" data-first-id="{{ group.first_event_id }}"><summary aria-label="Ver eventos de {{ group.action or 'Sin acción' }}; grupo {{ group.first_event_id }} de {{ group.event_count }} registros">{{ group.action or 'Sin acción' }}</summary></details></td>
<td class="event-date">{{ group.at|display_date(timezone) }}</td><td class="event-count">{{ group.event_count }}</td></tr>
<tr class="event-expand-row" hidden><td colspan="4"><div class="event-detail"><p class="muted note">Los detalles se consultan al abrir.</p></div></td></tr>
{% else %}<tr><td colspan="4" class="empty">Sin eventos recientes para este cargador</td></tr>{% endfor %}
</tbody></table></div>
<nav class="pages" aria-label="Páginas de eventos">
{% if event_page > 1 %}<a rel="prev" href="{{ request.url.include_query_params(event_page=event_page-1) }}#events">Anterior</a>{% endif %}
<span aria-current="page">{{ event_page }}</span>
{% if event_has_next %}<a rel="next" href="{{ request.url.include_query_params(event_page=event_page+1) }}#events">Siguiente</a>{% endif %}
</nav></section>
{% endif %}
</main>
{% if selected_connector_id is none %}
<script>
(() => {
  const chart = document.getElementById("energy-chart");
  const total = document.getElementById("energy-total");
  const count = document.getElementById("energy-sessions");
  const dayControls = document.querySelectorAll("[data-energy-days]");
  const viewControls = document.querySelectorAll("[data-energy-view]");
  const legend = document.getElementById("energy-legend");
  const helpButton = document.querySelector(".energy-help-trigger");
  const help = document.getElementById("energy-help");
  if (!chart || !total || !count || !legend || !helpButton || !help) return;
  const updateChartLabels = () => {
    const days = chart.dataset.days;
    const view = chart.dataset.view;
    chart.setAttribute("aria-label",
      "Energía " + (view === "total" ? "total" : "por conector") +
      " entregada por día, últimos " + days + " días, " + {{ timezone|tojson }});
    for (const day of chart.querySelectorAll(".energy-day")) {
      day.setAttribute("aria-label", day.dataset[
        view === "total" ? "totalDescription" : "connectorDescription"]);
    }
  };
  dayControls.forEach(button => button.addEventListener("click", () => {
    const days = button.dataset.energyDays;
    if (days !== "7" && days !== "30") return;
    chart.dataset.days = days;
    total.textContent = total.getAttribute("data-total-" + days) + " kWh";
    count.textContent = "· " + count.getAttribute("data-count-" + days) + " sesiones cerradas";
    dayControls.forEach(item => item.setAttribute("aria-pressed", String(item === button)));
    updateChartLabels();
  }));
  viewControls.forEach(button => button.addEventListener("click", () => {
    const view = button.dataset.energyView;
    if (view !== "total" && view !== "connectors") return;
    chart.dataset.view = view;
    legend.hidden = view !== "connectors";
    viewControls.forEach(item => item.setAttribute("aria-pressed", String(item === button)));
    updateChartLabels();
  }));
  helpButton.addEventListener("click", () => {
    help.hidden = !help.hidden;
    helpButton.setAttribute("aria-expanded", String(!help.hidden));
  });
  helpButton.addEventListener("keydown", event => {
    if (event.key === "Escape") {
      help.hidden = true;
      helpButton.setAttribute("aria-expanded", "false");
    }
  });
})();
</script>
{% endif %}
{% if selected_connector_id is none %}
<script>
(() => {
  for (const details of document.querySelectorAll(".event-group")) {
    const expandRow = details.closest(".event-summary-row").nextElementSibling;
    const holder = expandRow.querySelector(".event-detail");
    let offset = 0, exhausted = false, loading = false;
    const table = document.createElement("table");
    const head = document.createElement("thead"); const headRow = document.createElement("tr");
    for (const label of ["ID", "Fecha", "Información"]) {
      const th = document.createElement("th"); th.textContent = label; headRow.append(th);
    }
    head.append(headRow); table.append(head);
    const body = document.createElement("tbody"); table.append(body);
    const scroll = document.createElement("div"); scroll.className = "scroll"; scroll.append(table);
    const status = document.createElement("p"); status.className = "muted note";
    const more = document.createElement("button"); more.type = "button"; more.textContent = "Ver 50 más";
    holder.replaceChildren(scroll, status, more);
    const load = async () => {
      if (loading || exhausted) return;
      loading = true; more.disabled = true; status.textContent = "Cargando eventos…";
      const url = new URL("/api/v1/charger-event-group", window.location.origin);
      url.searchParams.set("source_id", {{ source_id|tojson }});
      url.searchParams.set("charger_id", {{ charger_id|tojson }});
      url.searchParams.set("tz", {{ timezone|tojson }});
      url.searchParams.set("first_event_id", details.dataset.firstId);
      url.searchParams.set("offset", String(offset));
      try {
        const response = await fetch(url, {credentials: "same-origin"});
        if (!response.ok) throw new Error("HTTP " + response.status);
        const page = await response.json();
        for (const event of page.events) {
          const tr = document.createElement("tr");
          for (const value of [event.id, event.display_at, event.information]) {
            const td = document.createElement("td"); td.textContent = value == null ? "—" : String(value);
            tr.append(td);
          }
          body.append(tr);
        }
        offset += page.events.length; exhausted = !page.has_next; more.hidden = exhausted;
        status.textContent = offset + " eventos cargados";
      } catch (_) { status.textContent = "No se pudieron cargar. Reintentar."; }
      finally {loading = false; more.disabled = false;}
    };
    more.addEventListener("click", load);
    details.addEventListener("toggle", () => {
      expandRow.hidden = !details.open;
      if (details.open && offset === 0) load();
    });
  }
})();
</script>
{% endif %}
</body></html>