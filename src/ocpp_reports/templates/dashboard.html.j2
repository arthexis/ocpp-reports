<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="refresh" content="15"><title>{{ title }}</title>
<style>
:root{color-scheme:light;--bg:#f5f7fa;--surface:#fff;--ink:#172437;--muted:#637286;--line:#e2e8f0;--nav:#203247;--accent:#1268c7;--warning:#a96700;font:16px system-ui,sans-serif}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);line-height:1.45}
header{background:var(--nav);color:white;padding:1.2rem max(1.25rem,calc((100vw - 1280px)/2));display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
header h1{margin:0;font-size:1.55rem;letter-spacing:-.03em}header .muted{color:#d0dbe6;margin:.2rem 0 0}
main{max-width:1320px;margin:auto;padding:1.4rem 1.25rem 3rem}
.filters{display:flex;gap:.75rem;align-items:end;flex-wrap:wrap}.filters label{display:grid;gap:.25rem;font-size:.82rem;font-weight:600}
input,button{font:inherit;border:1px solid var(--line);border-radius:8px;padding:.55rem .75rem;min-height:40px}
button{background:var(--accent);border-color:var(--accent);color:white;font-weight:600;cursor:pointer}
button:hover{filter:brightness(.92)}input{background:white;min-width:140px}
section{margin:0 0 1.25rem;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:1.25rem;box-shadow:0 2px 10px #152c4608}
section h2{font-size:1.05rem;margin:0 0 1rem}.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:.87rem}th,td{text-align:left;padding:.75rem .65rem;border-bottom:1px solid var(--line);white-space:nowrap}th{font-weight:650;background:#f6f8fb;color:#34455a}tbody tr:last-child td{border-bottom:0}
.muted{color:var(--muted)}.stale{color:var(--warning);font-weight:650}
.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}
.cards article{border:1px solid var(--line);border-radius:11px;padding:1.1rem;background:#f8fbff;display:flex;flex-direction:column;gap:.3rem}
.cards article:nth-child(2){background:#f2faf7}.cards article:nth-child(3){background:#fffaf0}.cards article:nth-child(4){background:#f8f6ff}
.cards strong{font-size:2rem;line-height:1.1;font-variant-numeric:tabular-nums}.cards article div{color:var(--muted);font-size:.86rem}
.dashboard-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;align-items:start}.dashboard-grid section{min-width:0;margin:0}
.summary{margin-bottom:1.25rem}.summary h2{margin-bottom:.85rem}
@media(max-width:900px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.dashboard-grid{grid-template-columns:1fr}header{padding:1.1rem 1.25rem}}
@media(max-width:520px){.cards{gap:.6rem}.cards article{padding:.8rem}.cards strong{font-size:1.65rem}main{padding:1rem .75rem}section{padding:1rem}header{padding:1rem}.filters{width:100%}.filters label{flex:1;min-width:120px}.filters input{width:100%;min-width:0}}
@media(prefers-color-scheme:dark){:root{color-scheme:dark;--bg:#111923;--surface:#1b2734;--ink:#e8eef6;--muted:#a5b3c3;--line:#344557;--nav:#0c1520;--accent:#5da5f5;--warning:#ffbe60}input{background:#243345;color:var(--ink)}button{color:#0b1b2c}th{background:#263647;color:#d7e5f5}.cards article,.cards article:nth-child(n){background:#223245}}
.status{display:inline-flex;align-items:center;gap:.4rem;border-radius:999px;padding:.2rem .5rem;font-size:.78rem;font-weight:650;background:#edf1f5}.status::before{content:"";width:.5rem;height:.5rem;border-radius:50%;background:#8795a7}.status--ok{background:#e3f6ed;color:#087342}.status--ok::before{background:#0b9960}.status--active{background:#e4f0ff;color:#155bad}.status--active::before{background:#1976e9}.status--warn{background:#fff3d9;color:#906000}.status--warn::before{background:#dfa000}.status--off{background:#f7e8e8;color:#984545}.status--off::before{background:#c55b5b}.numeric{text-align:right;font-variant-numeric:tabular-nums}.empty{text-align:center;color:var(--muted);padding:1.5rem}.note{font-size:.8rem}@media(prefers-color-scheme:dark){.status{background:#354657;color:#e1e9f3}.status--ok{background:#164333;color:#9ce7c1}.status--active{background:#193c62;color:#a9d4ff}.status--warn{background:#493c20;color:#ffe1a3}.status--off{background:#493039;color:#ffc0c7}}.clear-filters{color:var(--accent);padding:.55rem .4rem;font-size:.9rem;font-weight:600;text-decoration:none}.clear-filters:hover{text-decoration:underline}.skip-link{position:absolute;left:1rem;top:-5rem;background:white;color:#172437;padding:.6rem 1rem;z-index:10;border-radius:6px}.skip-link:focus{top:.5rem}a:focus-visible,button:focus-visible,input:focus-visible,.scroll:focus-visible{outline:3px solid var(--accent);outline-offset:3px}@media(max-width:520px){.filters button,.clear-filters{flex:1;text-align:center}.scroll{max-width:100%}th,td{padding:.65rem .55rem}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}
/* Operational summary: show actionable charger conditions before technical data. */
.operations{margin-bottom:.8rem}.operations h2{margin-bottom:.3rem}.operations .note{margin:.2rem 0 .7rem}
.operations-cards{gap:.65rem}.operational-card{display:flex;flex-direction:column;gap:.25rem;min-width:0;padding:.85rem 1rem;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--ink);text-decoration:none}
.operational-card strong{font-size:1.65rem;line-height:1.1;font-variant-numeric:tabular-nums}.operational-card span{font-size:.82rem;color:var(--muted)}
.operational-card--fault{border-left:4px solid #b94d4d}.operational-card:hover,.operational-card:focus-visible{border-color:var(--accent);text-decoration:underline}
.filter-panel h2{margin-bottom:.6rem}.filter-panel{padding:.85rem 1.25rem}
.dashboard-grid .connectors-panel{grid-column:1/-1}.charger-identity{overflow-wrap:anywhere}
@media(max-width:520px){
header{padding:.65rem .9rem}header h1{font-size:1.12rem}header .muted{font-size:.76rem;margin:0}
main{padding:.65rem}.operations{padding:.8rem}.operations .note{font-size:.73rem}
.operations-cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:.4rem}.operational-card{padding:.6rem;min-height:76px}.operational-card strong{font-size:1.45rem}.operational-card span{font-size:.75rem}
.filter-panel{padding:.75rem}.dashboard-grid .connectors-panel .scroll{overflow:visible}
.connectors-panel table,.connectors-panel tbody,.connectors-panel tr,.connectors-panel td{display:block;width:100%}
.connectors-panel thead{display:none}.connectors-panel tbody tr{margin-bottom:.65rem;border:1px solid var(--line);border-radius:9px;padding:.55rem;background:var(--surface)}
.connectors-panel td{white-space:normal;padding:.25rem .1rem;border:0;display:flex;justify-content:space-between;align-items:start;gap:.6rem;text-align:right;overflow-wrap:anywhere;font-size:.8rem}
.connectors-panel td::before{content:attr(data-label);font-size:.75rem;color:var(--muted);font-weight:650;text-align:left;flex:0 0 35%}
.connectors-panel td.empty{display:block;text-align:center}.connectors-panel td.empty::before{content:none}
}
</style></head><body>
<a class="skip-link" href="#content">Ir al contenido</a><header><div><h1>{{ title }}</h1><p class="muted">Estado de cargadores · Solo lectura · Página actualizada cada 15 s</p></div>
</header><main id="content">
{% set counts = namespace(faults=0, charging=0, available=0, uncertain=0) %}
{% for c in data.connectors %}
  {% set state = (c.status or '')|lower %}
  {% if state in ['faulted', 'unavailable'] %}{% set counts.faults = counts.faults + 1 %}{% endif %}
  {% if c.stale or not c.status %}{% set counts.uncertain = counts.uncertain + 1 %}
  {% elif state == 'charging' %}{% set counts.charging = counts.charging + 1 %}
  {% elif state == 'available' %}{% set counts.available = counts.available + 1 %}
  {% elif state not in ['faulted', 'unavailable'] %}{% set counts.uncertain = counts.uncertain + 1 %}{% endif %}
{% endfor %}
<section class="operations" aria-labelledby="operations-heading">
<h2 id="operations-heading">Estado de los cargadores</h2>
<p class="muted note">Último estado informado, no conectividad en tiempo real. Una falla antigua también puede contarse como dato antiguo.</p>
<div class="cards operations-cards">
<a class="operational-card operational-card--fault" href="#connectors"><strong>{{ counts.faults }}</strong><span>Falla / no disponible (último estado)</span></a>
<a class="operational-card" href="#connectors"><strong>{{ counts.charging }}</strong><span>Cargando</span></a>
<a class="operational-card" href="#connectors"><strong>{{ counts.available }}</strong><span>Disponibles</span></a>
<a class="operational-card" href="#connectors"><strong>{{ counts.uncertain }}</strong><span>Datos antiguos / otros</span></a>
</div></section>
<section class="filter-panel"><h2>Filtrar resultados</h2><form class="filters" method="get" role="search" aria-label="Filtrar datos del dashboard"><label>Origen <input name="source_id" value="{{ source_id }}" placeholder="Todos"></label>
<label>Cargador <input name="charger_id" value="{{ charger_id }}" placeholder="Todos"></label><button type="submit">Filtrar</button><a class="clear-filters" href="/">Limpiar filtros</a></form></section>
<div class="dashboard-grid"><section id="connectors" class="connectors-panel"><h2>Conectores</h2><div class="scroll" tabindex="0" role="region" aria-label="Tabla de conectores"><table><thead><tr><th>Ubicación</th><th>Cargador</th><th>Conector</th><th>Estado observado</th><th>Conectado*</th><th>Potencia</th><th>Energía registrada</th><th>Estado reportado</th><th>Snapshot recibido</th></tr></thead><tbody>
{% for c in data.connectors %}<tr><td data-label="Ubicación">{{ c.location }}</td><td data-label="Cargador" class="charger-identity">{{ c.charger_id }}</td><td data-label="Conector">{{ c.connector_id }}</td>
<td data-label="Estado">{% set state = (c.status or "")|lower %}<span class="status {% if state == 'charging' %}status--active{% elif state in ['available', 'finishing'] %}status--ok{% elif state in ['preparing', 'suspendedev', 'suspendedevse'] %}status--warn{% elif state in ['faulted', 'unavailable'] %}status--off{% endif %}">{{ c.status or "Desconocido" }}</span>{% if c.stale %} <span class="status status--warn">Antiguo</span>{% endif %}</td>
<td data-label="Conectado"><span class="status {{ 'status--ok' if c.connected else 'status--off' }}">{{ "Sí" if c.connected else "No" }} (observado)</span></td>
<td data-label="Potencia" class="numeric">{{ "%.2f"|format(c.power_w / 1000) ~ " kW" if c.power_w is not none else "—" }}</td>
<td data-label="Medidor" class="numeric">{{ "%.2f"|format(c.energy_wh / 1000) ~ " kWh" if c.energy_wh is not none else "—" }}</td><td data-label="Estado reportado">{{ c.status_observed_at or "Desconocido" }}</td><td data-label="Snapshot recibido">{{ c.observed_at or "Desconocido" }}</td></tr>
{% else %}<tr><td class="empty" colspan="9">Sin conectores registrados</td></tr>{% endfor %}</tbody></table></div>
<p class="muted note">* Última observación del productor, no una conexión en tiempo real. Energía registrada: lectura de medidor, no consumo de la sesión.</p></section>
<section id="synchronization"><h2>Sincronización</h2><p class="muted note">Ingestión local y recepción de réplica son distintas. La recarga de la página no confirma datos nuevos del cargador.</p><div class="scroll" tabindex="0" role="region" aria-label="Tabla de sincronización"><table><thead><tr><th>Origen</th><th>Cursor</th><th>Ingestión local</th><th>Recepción de réplica</th></tr></thead><tbody>
{% for s in data.sources %}<tr><td>{{ s.source_id }}</td><td>{{ s.cursor }}</td><td>{{ s.last_ingested_at or "No aplica / desconocido" }}</td><td>{{ s.last_replication_received_at or "No aplica / desconocido" }}</td></tr>{% else %}<tr><td class="empty" colspan="4">Sin orígenes</td></tr>{% endfor %}
</tbody></table></div></section>
<section><h2>Transacciones recientes</h2><div class="scroll" tabindex="0" role="region" aria-label="Tabla de transacciones recientes"><table><thead><tr><th>Ubicación</th><th>Cargador</th><th>ID</th><th>Estado</th><th>Inicio</th><th>Fin</th><th>Energía de sesión</th></tr></thead><tbody>
{% for t in data.transactions %}<tr><td>{{ t.location }}</td><td>{{ t.charger_id }}</td><td>{{ t.id }}</td><td><span class="status {{ 'status--active' if (t.state or '')|lower in ['open', 'active', 'charging'] else 'status--ok' if (t.state or '')|lower in ['closed', 'stopped', 'completed'] else '' }}">{{ t.state or "Desconocido" }}</span></td><td>{{ t.started_at or "—" }}</td><td>{{ t.stopped_at or "Activa / sin cierre" }}</td>
<td class="numeric">{% if t.energy_wh is defined and t.energy_wh is not none %}{{ "%.2f"|format(t.energy_wh / 1000) }} kWh (final){% elif t.live_energy_wh is defined and t.live_energy_wh is not none and t.active %}{{ "%.2f"|format(t.live_energy_wh / 1000) }} kWh <span class="{{ 'stale' if t.live_energy_stale else 'muted' }}">(estimada{% if t.live_energy_stale %}, antigua{% else %}, en vivo{% endif %})</span><div class="note muted">Medición: {{ t.live_energy_observed_at or "Sin fecha" }}</div>{% elif t.active %}Final pendiente · estimación no disponible{% else %}—{% endif %}</td></tr>
{% else %}<tr><td class="empty" colspan="7">Sin transacciones</td></tr>{% endfor %}</tbody></table></div></section>
<section><h2>Eventos recientes</h2><div class="scroll" tabindex="0" role="region" aria-label="Tabla de eventos recientes"><table><thead><tr><th>ID</th><th>Ubicación</th><th>Cargador</th><th>Acción</th><th>Fecha</th></tr></thead><tbody>
{% for e in data.events %}<tr><td>{{ e.id }}</td><td>{{ e.location }}</td><td>{{ e.charger_id }}</td><td>{{ e.action }}</td><td>{{ e.at }}</td></tr>
{% else %}<tr><td class="empty" colspan="5">Sin eventos</td></tr>{% endfor %}</tbody></table></div></section></div></main>
</body></html>