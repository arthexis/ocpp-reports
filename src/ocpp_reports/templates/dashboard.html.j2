{% macro panel_help(title, text) -%}
<button type="button" class="panel-help-trigger" aria-label="Información sobre {{ title }}" aria-haspopup="dialog" aria-controls="panel-help-dialog" data-help-title="{{ title }}" data-help-text="{{ text }}">ⓘ</button>
{%- endmacro %}
<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
{% include "favicon_links.html.j2" %}
<style>
:root{color-scheme:light;--bg:#f5f7fa;--surface:#fff;--ink:#172437;--muted:#637286;--line:#e2e8f0;--nav:#203247;--accent:#1268c7;--warning:#a96700;font:16px system-ui,sans-serif}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);line-height:1.45}
header{background:var(--nav);color:white;padding:1.2rem max(1.25rem,calc((100vw - 1280px)/2));display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
header h1{margin:0;font-size:1.55rem;letter-spacing:-.03em}header .brand-logo{display:block;max-height:56px;max-width:min(240px,65vw);width:auto;height:auto;object-fit:contain}header [hidden]{display:none!important}header .muted{color:#d0dbe6;margin:.2rem 0 0}
main{max-width:1320px;margin:auto;padding:1.4rem 1.25rem 3rem}
.filters{display:flex;gap:.75rem;align-items:end;flex-wrap:wrap}.filters label{display:grid;gap:.25rem;font-size:.82rem;font-weight:600}
input,button{font:inherit;border:1px solid var(--line);border-radius:8px;padding:.55rem .75rem;min-height:40px}
button{background:var(--accent);border-color:var(--accent);color:white;font-weight:600;cursor:pointer}
button:hover{filter:brightness(.92)}input{background:white;min-width:140px}
section{margin:0 0 1.25rem;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:1.25rem;box-shadow:0 2px 10px #152c4608}
section h2{font-size:1.05rem;margin:0 0 1rem}.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:.87rem}th,td{text-align:left;padding:.75rem .65rem;border-bottom:1px solid var(--line);white-space:nowrap}th{font-weight:650;background:#f6f8fb;color:#34455a}tbody tr:last-child td{border-bottom:0}
.muted{color:var(--muted)}.stale{color:var(--warning);font-weight:650}
.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}
.cards article{border:1px solid var(--line);border-radius:11px;padding:1.1rem;background:#f8fbff;display:flex;flex-direction:column;gap:.3rem}
.cards article:nth-child(2){background:#f2faf7}.cards article:nth-child(3){background:#fffaf0}.cards article:nth-child(4){background:#f8f6ff}
.cards strong{font-size:2rem;line-height:1.1;font-variant-numeric:tabular-nums}.cards article div{color:var(--muted);font-size:.86rem}
.dashboard-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;align-items:start}.dashboard-grid section{min-width:0;margin:0}
.summary{margin-bottom:1.25rem}.summary h2{margin-bottom:.85rem}
@media(max-width:900px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.dashboard-grid{grid-template-columns:1fr}header{padding:1.1rem 1.25rem}}
@media(max-width:520px){.cards{gap:.6rem}.cards article{padding:.8rem}.cards strong{font-size:1.65rem}main{padding:1rem .75rem}section{padding:1rem}header{padding:1rem}.filters{width:100%}.filters label{flex:1;min-width:120px}.filters input{width:100%;min-width:0}}
@media(prefers-color-scheme:dark){:root{color-scheme:dark;--bg:#111923;--surface:#1b2734;--ink:#e8eef6;--muted:#a5b3c3;--line:#344557;--nav:#0c1520;--accent:#5da5f5;--warning:#ffbe60}input{background:#243345;color:var(--ink)}button{color:#0b1b2c}th{background:#263647;color:#d7e5f5}.cards article,.cards article:nth-child(n){background:#223245}}
.status{display:inline-flex;align-items:center;gap:.4rem;border-radius:999px;padding:.2rem .5rem;font-size:.78rem;font-weight:650;background:#edf1f5}.status::before{content:"";width:.5rem;height:.5rem;border-radius:50%;background:#8795a7}.status--ok{background:#e3f6ed;color:#087342}.status--ok::before{background:#0b9960}.status--active{background:#e4f0ff;color:#155bad}.status--active::before{background:#1976e9}.status--warn{background:#fff3d9;color:#906000}.status--warn::before{background:#dfa000}.status--off{background:#f7e8e8;color:#984545}.status--off::before{background:#c55b5b}.numeric{text-align:right;font-variant-numeric:tabular-nums}.empty{text-align:center;color:var(--muted);padding:1.5rem}.note{font-size:.8rem}@media(prefers-color-scheme:dark){.status{background:#354657;color:#e1e9f3}.status--ok{background:#164333;color:#9ce7c1}.status--active{background:#193c62;color:#a9d4ff}.status--warn{background:#493c20;color:#ffe1a3}.status--off{background:#493039;color:#ffc0c7}}.clear-filters{color:var(--accent);padding:.55rem .4rem;font-size:.9rem;font-weight:600;text-decoration:none}.clear-filters:hover{text-decoration:underline}.skip-link{position:absolute;left:1rem;top:-5rem;background:white;color:#172437;padding:.6rem 1rem;z-index:10;border-radius:6px}.skip-link:focus{top:.5rem}a:focus-visible,button:focus-visible,input:focus-visible,.scroll:focus-visible{outline:3px solid var(--accent);outline-offset:3px}@media(max-width:520px){.filters button,.clear-filters{flex:1;text-align:center}.scroll{max-width:100%}th,td{padding:.65rem .55rem}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}
/* Operational summary: show actionable charger conditions before technical data. */
.operations{margin-bottom:.8rem}.operations h2{margin-bottom:.3rem}.operations .note{margin:.2rem 0 .7rem}
.operations-cards{gap:.65rem}.operational-card{display:flex;flex-direction:column;gap:.25rem;min-width:0;padding:.85rem 1rem;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--ink);text-decoration:none}
.operational-card strong{font-size:1.65rem;line-height:1.1;font-variant-numeric:tabular-nums}.operational-card span{font-size:.82rem;color:var(--muted)}
.operational-card--available{border-left:4px solid #19975b}.operational-card--charging{border-left:4px solid #1976e9}.operational-card--fault{border-left:4px solid #b94d4d}.operational-card--uncertain{border-left:4px solid #dba520}.operational-card:hover,.operational-card:focus-visible{border-color:var(--accent);text-decoration:underline}
.filter-panel h2{margin-bottom:.6rem}.filter-panel{padding:.85rem 1.25rem}
.dashboard-grid .connectors-panel{grid-column:1/-1}.charger-identity{overflow-wrap:anywhere}
@media(max-width:520px){
header{padding:.65rem .9rem}header h1{font-size:1.12rem}header .muted{font-size:.76rem;margin:0}
main{padding:.65rem}.operations{padding:.8rem}.operations .note{font-size:.73rem}
.operations-cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:.4rem}.operational-card{padding:.6rem;min-height:76px}.operational-card strong{font-size:1.45rem}.operational-card span{font-size:.75rem}
.filter-panel{padding:.75rem}.dashboard-grid .connectors-panel .scroll{overflow:visible}
.connectors-panel table,.connectors-panel tbody,.connectors-panel tr,.connectors-panel td{display:block;width:100%}
.connectors-panel thead{display:none}.connectors-panel tbody tr{margin-bottom:.65rem;border:1px solid var(--line);border-radius:9px;padding:.55rem;background:var(--surface)}
.connectors-panel td{white-space:normal;padding:.25rem .1rem;border:0;display:flex;justify-content:space-between;align-items:start;gap:.6rem;text-align:right;overflow-wrap:anywhere;font-size:.8rem}
.connectors-panel td::before{content:attr(data-label);font-size:.75rem;color:var(--muted);font-weight:650;text-align:left;flex:0 0 35%}
.connectors-panel td.empty{display:block;text-align:center}.connectors-panel td.empty::before{content:none}
}

/* Compact filters in the navigation/header, responsive without a separate panel. */
header .brand{min-width:0}
.header-filters{margin-left:auto;align-self:flex-start;align-items:flex-start;gap:.5rem}
.header-filters label{display:flex;flex-direction:column;align-items:stretch;gap:.2rem;color:#d0dbe6;font-size:.75rem}
.header-filters input{width:155px;min-width:0;min-height:36px;font-size:.85rem;padding:.4rem .55rem}
.header-filters .clear-filters{color:#e0ebfa;white-space:nowrap;padding:.35rem .2rem}
@media(max-width:700px){
header{align-items:start;gap:.65rem}
.header-filters{margin:0;width:100%;flex-wrap:nowrap}
.header-filters label{flex:1;min-width:0}
.header-filters input{width:100%}
.header-filters .clear-filters{align-self:end}
}

/* Full-width transaction evidence; compact supporting operations below. */
.dashboard-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;align-items:start}
.dashboard-grid .connectors-panel,.dashboard-grid .transactions-panel{grid-column:1/-1}
.dashboard-grid .events-panel{grid-column:2;grid-row:auto}
.dashboard-grid .rfid-panel{grid-column:1;grid-row:auto}
.dashboard-grid .users-panel{grid-column:2;grid-row:auto}
.dashboard-grid section{margin:0;min-width:0}
.header-filters .unified-filter{width:min(390px,38vw);min-width:245px;height:44px;min-height:44px}
.header-filters{margin-left:auto}
/* A native select is the timezone link itself: one click opens the options. */
.tz-picker{display:inline-flex;align-items:baseline;vertical-align:baseline;position:relative;max-width:100%}
.tz-picker::after{content:"▾";color:#d8e8fa;pointer-events:none;margin-left:.3em}
.tz-picker select{font:inherit;color:#d8e8fa;background:transparent;border:0;border-radius:0;padding:0;margin:0;min-width:0;max-width:100%;width:auto;field-sizing:content;appearance:none;-webkit-appearance:none;text-decoration:underline;text-underline-offset:2px;cursor:pointer}
.tz-picker select:focus-visible{outline:2px solid #d8e8fa;outline-offset:3px}
.tz-picker select option{color:#172437;background:#fff}
.events-panel details{padding:.5rem .2rem;border-bottom:1px solid var(--line)}
.events-panel details summary{cursor:pointer;font-weight:600}
.events-panel details[open] summary{padding-bottom:.5rem}
.events-panel .scroll{max-height:340px;overflow:auto}
.transactions-panel .scroll{max-width:100%}
.transactions-panel .session-soc{white-space:nowrap}
@media(max-width:1100px){.header-filters{width:100%;justify-content:start}.dashboard-grid{grid-template-columns:1fr}.dashboard-grid section,.dashboard-grid .connectors-panel,.dashboard-grid .transactions-panel,.dashboard-grid .events-panel,.dashboard-grid .rfid-panel,.dashboard-grid .users-panel{grid-column:1}}
@media(max-width:700px){.header-filters{flex-wrap:wrap}.header-filters label{flex:1 1 100%}.header-filters .unified-filter{width:100%;min-width:0}.header-filters .filter-caption{display:none}}
/* Narrow phones: trim vertical chrome without reducing the search touch target. */
@media(max-width:520px){
  header{padding:.5rem .9rem;gap:.3rem}
  header .brand{line-height:1.25}
  header .muted{line-height:1.3}
  .header-filters{gap:0;margin:0}
  .header-filters label{gap:0}
  .header-filters .unified-filter{font-size:.85rem;line-height:normal;min-height:44px}
}

.transaction-pagination{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem;margin-top:.75rem}
.transaction-pages{display:flex;align-items:center;gap:.25rem;flex-wrap:wrap}
.transaction-pages a,.transaction-pages span.page-current,.transaction-pages span.page-disabled{display:inline-flex;min-width:2rem;min-height:2rem;align-items:center;justify-content:center;padding:.2rem .5rem;border-radius:.4rem;text-decoration:none;font-size:.86rem}
.transaction-pages a{color:var(--accent);border:1px solid var(--line)}
.transaction-pages a:hover{background:var(--bg)}
.transaction-pages .page-current{background:var(--accent);color:var(--surface);font-weight:700}
.transaction-pages .page-disabled{color:var(--muted);opacity:.65}
.transaction-filters span,.connector-filters span{color:var(--muted)}
.charger-session-link{display:inline-flex;align-items:center;min-width:44px;min-height:44px;max-width:100%;color:var(--accent);font-weight:650;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}
.status-session-link{display:inline-flex;align-items:center;min-height:44px;max-width:100%;border-radius:999px;text-decoration:none}
.status-session-link:hover .status,.status-session-link:focus-visible .status{text-decoration:underline;text-underline-offset:3px}
.status-session-link .status{white-space:nowrap;overflow-wrap:normal}
.current-session-pending{display:inline-block;margin-left:.35rem;font-size:.78rem;color:var(--muted)}
.connector-status-content{display:inline-flex;align-items:center;flex-wrap:wrap;gap:.3rem;min-width:0}
@media(max-width:520px){
  /* Keep status chips intact and let their wrapper be the tap target. */
  .connectors-panel td[data-label="Estado"] .connector-status-content{flex:1 1 0;min-width:0;justify-content:flex-end;gap:.35rem}
  .connectors-panel td[data-label="Estado"] .status{white-space:nowrap;overflow-wrap:normal}
  .connectors-panel td[data-label="Estado"] .status-session-link{flex:0 0 auto}
  .connectors-panel td[data-label="Cargador"] .charger-session-link{min-height:44px}
}

/* Help overlays the dashboard without affecting table geometry. */
.panel-heading{display:flex;align-items:center;gap:.35rem;margin-bottom:.5rem;min-width:0;flex:1 1 auto;flex-wrap:wrap}
.panel-heading h2{margin:0}
.panel-help-trigger{flex:0 0 auto;border:0;background:transparent;color:var(--muted);font-size:1.15rem;line-height:1;cursor:pointer;border-radius:100%;min-width:32px;min-height:32px;padding:.2rem}
.panel-help-trigger:hover,.panel-help-trigger:focus-visible{color:var(--accent)}
.panel-help-tooltip{position:fixed;z-index:1000;width:min(25rem,calc(100% - 1rem));max-height:calc(100% - 1rem);overflow:auto;overscroll-behavior:contain;padding:.75rem;border:1px solid var(--line);border-radius:.55rem;background:var(--surface);color:var(--ink);box-shadow:0 6px 20px #0003;font-size:.84rem;line-height:1.45;white-space:normal}
.panel-help-tooltip[hidden]{display:none}
.panel-help-dialog{position:fixed;box-sizing:border-box;width:min(28rem,calc(100% - 2rem));max-height:calc(100% - 2rem);overflow:auto;overscroll-behavior:contain;margin:auto;padding:1rem;border:1px solid var(--line);border-radius:.75rem;background:var(--surface);color:var(--ink);box-shadow:0 12px 40px #0004}
.panel-help-dialog::backdrop{background:rgba(0,0,0,.25)}
.panel-help-dialog-heading{display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin:0 0 .5rem;padding:0;background:none;border:0;position:static}
.panel-help-dialog h2{font-size:1.05rem;margin:0}
.panel-help-dialog p{margin:0;font-size:.9rem;line-height:1.55;white-space:pre-line}
.panel-help-close{border:0;background:transparent;color:inherit;font-size:1.35rem;min-width:40px;min-height:40px;cursor:pointer}
@media(max-width:520px){.panel-help-trigger{min-width:40px;min-height:40px}}

/* Readability: contain wide desktop data without clipping the viewport. */
.connectors-panel .scroll{width:100%;max-width:100%;min-width:0;overflow-x:auto;overscroll-behavior-x:contain}
.connectors-panel .connector-last-charge,.connectors-panel .connector-charge-count{display:none}
@media(min-width:1101px){
  .connectors-panel th.connector-last-charge,.connectors-panel td.connector-last-charge,
  .connectors-panel th.connector-charge-count,.connectors-panel td.connector-charge-count{display:table-cell}
}
@media(min-width:521px){.connectors-panel table{min-width:1140px}}
.counts-legend{font-size:.75rem;color:var(--muted);margin:-.3rem 0 .55rem}
.status--historic{background:#e9edf2;color:#4c5969}
.status--historic::before{background:#7c8998}
@media(prefers-color-scheme:dark){.status--historic{background:#364354;color:#c1cbd8}}
@media(max-width:520px){
  .operations{margin-bottom:.55rem}
  .counts-legend{margin:-.15rem 0 .4rem;font-size:.7rem}
  .dashboard-grid{gap:.6rem}
  .dashboard-grid > section{padding:.7rem}
  .connectors-panel tbody tr{padding:.4rem;margin-bottom:.45rem}
  .connectors-panel td{padding:.18rem .05rem;gap:.35rem}
  .connectors-panel td::before{flex-basis:32%}
  header .muted{font-size:.72rem}
}

/* Mobile: keep historical semantics without turning each status into a tall badge. */
.connector-scroll-hint{font-size:.76rem;color:var(--muted);text-align:right;margin:-.3rem 0 .35rem}
.connector-scroll-hint[hidden]{display:none}
@media(max-width:520px){
  .connector-mobile-text{display:inline}
  .connectors-panel td[data-label="Estado"] .status,
  .connectors-panel td[data-label="Conectado"] .status{font-size:.96rem;line-height:1.25;padding:.2rem .35rem;gap:.25rem}
  .connectors-panel td[data-label="Estado"] .status::before,
  .connectors-panel td[data-label="Conectado"] .status::before{width:.4rem;height:.4rem;flex-shrink:0}
  .connectors-panel td[data-label="Estado"]{align-items:center}
  .connector-scroll-hint{display:none}
}
.profile-menu{position:relative;align-self:flex-start}
.profile-menu summary{list-style:none;display:grid;place-items:center;cursor:pointer;border:1px solid #718096;border-radius:8px;height:44px;min-height:44px;padding:0 10px}
.profile-menu summary::-webkit-details-marker{display:none}
.profile-popover{position:absolute;right:0;top:calc(100% + 8px);z-index:20;min-width:210px;padding:12px;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:10px;box-shadow:0 8px 28px #0003;display:grid;gap:9px}
.profile-name{overflow-wrap:anywhere;border-bottom:1px solid var(--line);padding-bottom:8px}
.profile-popover a{color:var(--accent);text-decoration:none}
.profile-popover form{margin:0}
.profile-popover button{width:100%;text-align:left}
.dashboard-logout{display:flex;align-items:center;margin:0}
.dashboard-logout button{display:grid;place-items:center;cursor:pointer;background:transparent;color:inherit;border:1px solid var(--border, #718096);border-radius:7px;padding:8px}
.dashboard-logout button:hover,.dashboard-logout button:focus-visible{background:var(--surface, #34475b);outline-offset:2px}
/* Mobile header and connector cards: one search/profile row, two fields per row. */
@media(max-width:520px){
  header .brand{flex:0 0 100%;width:100%}
  .header-filters{flex:1 1 0;width:auto;min-width:0;flex-wrap:nowrap}
  .header-filters label{flex:1 1 0;min-width:0}
  .header-filters .unified-filter{width:100%;min-width:0}
  .profile-menu{flex:0 0 auto;margin-left:.15rem}
  .profile-menu summary{min-width:44px;min-height:44px}
  /* Swap the field groups on phones while retaining their original top-to-bottom order. */
  .connectors-panel tbody tr{display:grid;grid-template-columns:minmax(0,1.32fr) minmax(0,.68fr);column-gap:.28rem;row-gap:.14rem;align-items:start}
  .connectors-panel td{display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-start;text-align:left;min-width:0;overflow-wrap:anywhere;font-size:1.18rem;line-height:1.2;padding:.1rem .02rem calc(.1rem + 1px);gap:.08rem}
  /* Do not force a 44px line box: it adds blank space below the linked value.
     Expand the link's clickable pseudo-surface upward over its own label,
     without changing the grid row's intrinsic height. */
  .connectors-panel td[data-label="Cargador"] .charger-session-link,
  .connectors-panel td[data-label="Conector"] .charger-session-link{
    display:inline-block;position:relative;min-height:0;max-width:100%;
    margin:0;padding:0;line-height:1.2;vertical-align:top
  }
  .connectors-panel td[data-label="Cargador"] .charger-session-link::after,
  .connectors-panel td[data-label="Conector"] .charger-session-link::after{
    content:"";position:absolute;left:0;right:0;bottom:0;height:44px
  }
  .connectors-panel td::before{flex:0 0 auto;width:100%;font-size:.77rem;line-height:1.13}
  .connectors-panel td[data-label="Conector"]{grid-area:1/2}
  .connectors-panel td[data-label="Conectado"]{grid-area:3/2}
  .connectors-panel td[data-label="Potencia"]{grid-area:2/2}
  .connectors-panel td[data-label="Medidor"]{grid-area:4/1}
  .connectors-panel td[data-label="Ubicación"]{grid-area:1/1}
  .connectors-panel td[data-label="Cargador"]{grid-area:2/1}
  .connectors-panel td[data-label="Estado"]{grid-area:3/1;align-items:flex-start}
  .connectors-panel td[data-label="Recibido"]{grid-area:4/2}
  .connectors-panel td[data-label="Potencia"] .connector-power{display:inline-flex;align-items:baseline;flex-wrap:wrap;gap:.08rem .16rem;max-width:100%;white-space:normal}
  .connectors-panel td[data-label="Potencia"] .connector-power .note{font-size:.73rem}
  .connectors-panel td[data-label="Estado"] .connector-status-content{flex:0 1 auto;justify-content:flex-start;align-items:flex-start}
  .connectors-panel td.empty{grid-column:1/-1;grid-row:auto}
}
/* Tablet and compact desktop: keep search/profile paired and show essential columns. */
@media(min-width:521px) and (max-width:1100px){
  header .brand{flex:0 0 100%;width:100%}
  header .header-filters{flex:1 1 0;width:auto;min-width:0;margin:0;flex-wrap:nowrap;align-items:flex-start}
  header .header-filters label{flex:1 1 0;min-width:0}
  header .header-filters .unified-filter{width:100%;min-width:0}
  header .profile-menu{flex:0 0 auto;align-self:flex-start;margin-left:.25rem}
  header .profile-menu summary{min-width:44px;min-height:44px}
  .connectors-panel table{min-width:0;width:100%;table-layout:fixed}
  .connectors-panel th,.connectors-panel td{padding:.6rem .42rem}
  .connectors-panel th:nth-child(2),.connectors-panel td:nth-child(2),
  .connectors-panel th:nth-child(6),.connectors-panel td:nth-child(6),
  .connectors-panel th:nth-child(7),.connectors-panel td:nth-child(7),
  .connectors-panel th:nth-child(8),.connectors-panel td:nth-child(8),
  .connectors-panel th:nth-child(9),.connectors-panel td:nth-child(9),
  .connectors-panel th:nth-child(10),.connectors-panel td:nth-child(10){display:none}
  .connectors-panel th:nth-child(1){width:35%}
  .connectors-panel th:nth-child(3){width:15%}
  .connectors-panel th:nth-child(4){width:30%}
  .connectors-panel th:nth-child(5){width:20%}
  .connectors-panel td:nth-child(1),.connectors-panel td:nth-child(4){white-space:normal;overflow-wrap:anywhere}
  .transactions-panel th,.transactions-panel td{padding:.65rem .45rem}
  .transactions-panel th:nth-child(2),.transactions-panel tbody td:nth-child(2),
  .transactions-panel th:nth-child(6),.transactions-panel tbody td:nth-child(6),
  .transactions-panel th:nth-child(8),.transactions-panel tbody td:nth-child(8),
  .transactions-panel th:nth-child(9),.transactions-panel tbody td:nth-child(9){display:none}
}
/* The main dashboard is a summary on phones. Keep connector, session link,
   status, end time and energy; hide secondary history/SoC columns only here. */
@media(max-width:520px){
  .transactions-panel th:nth-child(1),.transactions-panel tbody td:nth-child(1),
  .transactions-panel th:nth-child(6),.transactions-panel tbody td:nth-child(6),
  .transactions-panel th:nth-child(8),.transactions-panel tbody td:nth-child(8),
  .transactions-panel th:nth-child(9),.transactions-panel tbody td:nth-child(9){display:none}
  .transactions-panel th,.transactions-panel td{padding:.5rem .3rem}
  .transactions-panel tbody td:nth-child(2){white-space:normal;overflow-wrap:anywhere}
}
/* Power is useful at tablet widths with room for its nominal/measured qualifier. */
@media(min-width:760px) and (max-width:1100px){
  .connectors-panel th:nth-child(6),.connectors-panel td:nth-child(6){display:table-cell}
  .connectors-panel th:nth-child(1){width:29%}
  .connectors-panel th:nth-child(3){width:12%}
  .connectors-panel th:nth-child(4){width:24%}
  .connectors-panel th:nth-child(5){width:14%}
  .connectors-panel th:nth-child(6){width:21%}
}
{% include "table_panel.css.j2" %}
{% include "page_geometry.css.j2" %}
</style></head><body>
<a class="skip-link" href="#content">Ir al contenido</a><header><div class="brand">{% if brand_image_url %}<img class="brand-logo" src="{{ brand_image_url }}" alt="{{ title }}" width="56" height="56" onerror="this.hidden=true;this.nextElementSibling.hidden=false"><h1 hidden>{{ title }}</h1>{% else %}<h1>{{ title }}</h1>{% endif %}
<div class="muted">Solo lectura · Refresco de pantalla cada 5 s ·
<span class="tz-picker"><select id="timezone-choice" aria-label="Zona horaria">{% for zone in timezones %}
<option value="{{ zone }}" {{ 'selected' if timezone == zone else '' }}>{{ zone }}</option>{% endfor %}</select></span></div></div>
<form id="dashboard-filters" class="filters header-filters" method="get" action="/" role="search" aria-label="Filtrar datos del dashboard">
<label for="dashboard-search"><input id="dashboard-search" class="unified-filter" type="search" name="filter" value="{{ filter }}" placeholder="Cargador, ubicación o estado" autocomplete="off"><span class="filter-caption">Filtrar</span></label>
<input type="hidden" name="tz" id="timezone-value" value="{{ timezone }}">
<input type="hidden" name="tx_view" value="{{ tx_view }}">
<input type="hidden" name="connector_view" value="{{ connector_view }}">
</form>
{% if login_enabled %}
<details class="profile-menu"><summary title="Perfil" aria-label="Abrir menú de perfil"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg></summary>
<div class="profile-popover"><strong class="profile-name">{{ current_username }}</strong><a href="/change-password">Cambiar contraseña</a><form method="post" action="/logout"><button type="submit">Cerrar sesión</button></form></div>
</details>
{% endif %}
</header><main id="content">
<section class="operations" aria-labelledby="operations-heading">
<div class="panel-heading"><h2 id="operations-heading">Estado de los cargadores</h2>{{ panel_help('Estado de los cargadores', 'Estaciones (conectores individuales): C0 no se duplica. Se muestra el último estado, no una prueba de conexión actual. Una falla con origen atrasado también puede contarse como dato incierto.') }}</div>
<p class="counts-legend">Cifras: estaciones (conectores individuales)</p><div class="cards operations-cards">
<a class="operational-card operational-card--available" href="#connectors"><strong>{{ operational_counts.available.stations }} ({{ operational_counts.available.connectors }})</strong><span>Disponibles</span></a>
<a class="operational-card operational-card--charging" href="{{ active_transactions_href|default('#connectors') }}"><strong>{{ operational_counts.charging.stations }} ({{ operational_counts.charging.connectors }})</strong><span>Cargando</span></a>
<a class="operational-card operational-card--fault" href="#connectors"><strong>{{ operational_counts.faults.stations }} ({{ operational_counts.faults.connectors }})</strong><span>Falla / no disponible (último estado)</span></a>
<a class="operational-card operational-card--uncertain" href="#connectors"><strong>{{ operational_counts.uncertain.stations }} ({{ operational_counts.uncertain.connectors }})</strong><span>Datos antiguos / otros</span></a>
</div></section>

<div class="dashboard-grid"><section id="connectors" class="connectors-panel"><div class="transactions-heading table-panel-heading"><div class="panel-heading"><h2>Conectores</h2>{{ panel_help('Conectores', 'Estado: último informado; Recibido: fecha original del estado, no la hora de recepción del snapshot. Conectado: Sí/No según la observación vigente del CSMS, o Desconocido si falta evidencia. Potencia: medida reciente o capacidad nominal. Energía: medidor acumulado, no consumo de sesión. Cargas: transacciones históricas, incluso abiertas o sin energía. C0 resume la estación; no sumar sus valores a los de los conectores.') }}</div>
<div class="connector-filters table-panel-actions" role="group" aria-label="Filtrar conectores">
<button type="button" data-connector-view="individual" aria-pressed="{{ 'true' if connector_view == 'individual' else 'false' }}" class="{{ 'selected' if connector_view == 'individual' else '' }}">Individual</button>
<span aria-hidden="true">|</span>
<button type="button" data-connector-view="station" aria-pressed="{{ 'true' if connector_view == 'station' else 'false' }}" class="{{ 'selected' if connector_view == 'station' else '' }}">Estación</button>
<span aria-hidden="true">|</span>
<button type="button" data-connector-view="combined" aria-pressed="{{ 'true' if connector_view == 'combined' else 'false' }}" class="{{ 'selected' if connector_view == 'combined' else '' }}">Combinado</button>
</div></div><p class="connector-scroll-hint" id="connector-scroll-hint" hidden>→ Más columnas</p><div class="scroll" tabindex="0" role="region" aria-label="Tabla de conectores" aria-describedby="connector-scroll-hint"><table><thead><tr><th>Ubicación</th><th>Cargador</th><th>Conector</th><th>Estado</th><th>Conectado</th><th class="numeric">Potencia</th><th class="numeric">Energía</th><th class="numeric connector-charge-count">Cargas</th><th class="connector-last-charge">Última carga</th><th>Recibido</th></tr></thead><tbody>
{% for c in connector_rows %}{% set session_href = ("/transactions/" ~ (c.source_id|urlencode) ~ "/" ~ (c.charger_id|urlencode) ~ "/" ~ (c.active_transaction_id|string) ~ "?tz=" ~ (timezone|urlencode) ~ "&return_to=" ~ (("/?" ~ (request.url.query if request is defined else '') ~ "#transactions")|urlencode)) if c.active_transaction_id is not none else none %}
<tr><td data-label="Ubicación">{{ c.location if c.location != c.source_id else "—" }}</td><td data-label="Cargador" class="charger-identity">
<a class="charger-session-link" href="/chargers/{{ c.source_id|urlencode }}/{{ c.charger_id|urlencode }}?tz={{ timezone|urlencode }}" aria-label="Ver cargador {{ c.charger_id }}">{{ c.charger_id }}</a>
</td><td data-label="Conector"><a class="charger-session-link" href="/connectors/{{ c.source_id|urlencode }}/{{ c.charger_id|urlencode }}/{{ c.connector_id }}?tz={{ timezone|urlencode }}" aria-label="Ver conector {{ c.connector_id }} del cargador {{ c.charger_id }}">{{ c.connector_id }}</a></td>
<td data-label="Estado"><span class="connector-status-content">{% set state = (c.status or "")|lower %}{% set discrepancy = c.status_discrepancy_badge %}{% if session_href %}<a class="status-session-link" href="{{ session_href }}" aria-label="{{ 'Ver última sesión informada, sin confirmación reciente' if c.stale else 'Ver carga actual' }} desde el estado del cargador {{ c.charger_id }}, conector {{ c.connector_id }}">{% endif %}<span class="status {% if discrepancy == 'Warning' %}status--warn{% elif discrepancy == 'Failed' %}status--off{% elif c.stale and state in ['available', 'finishing', 'charging'] %}status--historic{% elif state == 'charging' %}status--active{% elif state in ['available', 'finishing'] %}status--ok{% elif state in ['preparing', 'suspendedev', 'suspendedevse'] %}status--warn{% elif state in ['faulted', 'unavailable'] %}status--off{% endif %}"{% if discrepancy %} title="Estación C0: {{ 'Available' if discrepancy == 'Warning' else 'Faulted' }} · Conector C{{ c.connector_id }}: {{ c.status }}" aria-label="{{ discrepancy }}. Estación C0: {{ 'Available' if discrepancy == 'Warning' else 'Faulted' }}; conector C{{ c.connector_id }}: {{ c.status }}"{% endif %}>{{ discrepancy or c.status or "Desconocido" }}</span>{% if session_href %}</a>{% endif %}{% if c.status_time_unknown %} <span class="status status--historic">Estado sin fecha</span>{% endif %}
{% if not session_href and state == "charging" and c.connector_id != 0 %}<span class="current-session-pending">Transacción aún no disponible</span>{% endif %}</span></td>
<td data-label="Conectado"><span class="status {{ 'status--warn' if not c.connection_fresh else ('status--ok' if c.connected else 'status--off') }}" title="{{ "Conexión observada por el CSMS; no es una prueba de red en tiempo real" if c.connection_fresh else "Sin evidencia vigente de conexión del cargador" }}">{{ "Desconocido" if not c.connection_fresh else "Sí" if c.connected is sameas true else "No" }}</span></td>
<td data-label="Potencia" class="numeric"><span class="connector-power">{% if c.power_fresh and c.power_w is not none %}{{ "%.2f"|format(c.power_w / 1000) }} kW <span class="note muted" title="Power.Active.Import: medición reciente">medida</span>{% elif c.rated_power_w is defined and c.rated_power_w is not none %}{{ "%.2f"|format(c.rated_power_w / 1000) }} kW <span class="note muted" title="{{ 'Capacidad nominal del cargador, compartida; no es potencia medida' if c.connector_id == 0 or c.rating_scope == 'charger' else 'Capacidad nominal específica del conector; no es potencia medida' }}">nominal</span>{% else %}—{% endif %}</span></td>
<td data-label="Medidor" class="numeric">{% set displayed_energy_wh = c.aggregate_energy_wh if c.connector_id == 0 and c.aggregate_energy_wh is defined else c.energy_wh %}{{ "%.2f"|format(displayed_energy_wh / 1000) ~ " kWh" if displayed_energy_wh is not none else "—" }}</td><td class="numeric connector-charge-count" data-label="Cargas">{{ c.charge_count|default(0) }}</td><td class="connector-last-charge" data-label="Última carga">{{ c.last_charge_at|display_date(timezone) if c.last_charge_at else "—" }}</td><td data-label="Recibido">{{ c.status_observed_at|display_date(timezone) if not c.status_time_unknown else "Desconocido" }}</td></tr>
{% else %}<tr><td class="empty" colspan="10">Sin conectores registrados</td></tr>{% endfor %}</tbody></table></div>
</section>
<section class="transactions-panel" id="transactions"><div class="transactions-heading table-panel-heading"><div class="panel-heading"><h2>Sesiones de carga</h2>{{ panel_help('Sesiones de carga', 'En curso: sesiones activas; Exitosas: energía final positiva; Fallidas: energía final cero. Sin energía final conocida, no se clasifican como exitosas ni fallidas. SoC: primera y última lectura recibidas, no necesariamente al cierre. La energía en vivo es estimada.') }}</div>
<div class="transaction-filters table-panel-actions" role="group" aria-label="Filtrar transacciones por estado y energía final">
<button type="button" data-tx-view="active" aria-pressed="{{ 'true' if tx_view == 'active' else 'false' }}" class="{{ 'selected' if tx_view == 'active' else '' }}">En curso ({{ transaction_counts.get("active", 0) }})</button>
<span aria-hidden="true">|</span>
<button type="button" data-tx-view="success" aria-pressed="{{ 'true' if tx_view == 'success' else 'false' }}" class="{{ 'selected' if tx_view == 'success' else '' }}">Exitosas ({{ transaction_counts["success"] }})</button>
<span aria-hidden="true">|</span>
<button type="button" data-tx-view="failed" aria-pressed="{{ 'true' if tx_view == 'failed' else 'false' }}" class="{{ 'selected' if tx_view == 'failed' else '' }}">Fallidas ({{ transaction_counts["failed"] }})</button>
<span aria-hidden="true">|</span>
<button type="button" data-tx-view="all" aria-pressed="{{ 'true' if tx_view == 'all' else 'false' }}" class="{{ 'selected' if tx_view == 'all' else '' }}">Todas ({{ transaction_counts["all"] }})</button>
</div></div>
<div class="scroll" tabindex="0" role="region" aria-label="Tabla de transacciones recientes"><table><thead><tr><th>Ubicación</th><th>Cargador</th><th>Conector</th><th>ID</th><th>RFID</th><th>Estado</th><th>Inicio</th><th>Fin</th><th>Duración</th><th class="numeric session-soc" title="Primera y última lectura SoC recibidas; la última no necesariamente corresponde al cierre">SoC %</th><th class="numeric">Energía</th></tr></thead><tbody>
{% for t in data.transactions %}<tr><td>{{ t.location if t.location != t.source_id else "—" }}</td><td>{{ t.charger_id }}</td><td>{% if t.connector_id is defined and t.connector_id is integer and t.connector_id >= 0 %}<a href="/connectors/{{ t.source_id|urlencode }}/{{ t.charger_id|urlencode }}/{{ t.connector_id }}?tz={{ timezone|urlencode }}" aria-label="Ver conector {{ t.connector_id }} del cargador {{ t.charger_id }}">{{ t.connector_id }}</a>{% else %}—{% endif %}</td><td><a href="/transactions/{{ t.source_id|urlencode }}/{{ t.charger_id|urlencode }}/{{ t.id }}?tz={{ timezone|urlencode }}&return_to={{ ('/?' ~ (request.url.query if request is defined else '') ~ '#transactions')|urlencode }}" aria-label="Ver detalles de transacción {{ t.id }}">{{ t.id }}</a></td><td>{% if t.rfid is defined and t.rfid is string and t.rfid|trim %}<a href="/rfid?{{ {'rfid': t.rfid, 'tz': timezone}|urlencode }}">{{ t.rfid }}</a>{% else %}—{% endif %}</td><td><span class="status {{ 'status--active' if (t.state or '')|lower in ['open', 'active', 'charging'] else 'status--ok' if (t.state or '')|lower in ['closed', 'stopped', 'completed'] else '' }}">{{ t.state or "Desconocido" }}</span></td><td>{{ t.started_at|display_date(timezone) }}</td><td>{{ t.stopped_at|display_date(timezone) if t.stopped_at else "Activa / sin cierre" }}</td><td>{{ t.started_at|session_duration(t.stopped_at) }}</td>
<td class="numeric session-soc">{{ (t.soc_start|string ~ '%') if t.soc_start is defined and t.soc_start is not none else '—' }} - {{ (t.soc_end|string ~ '%') if t.soc_end is defined and t.soc_end is not none else '—' }}</td>
<td class="numeric">{% if t.energy_wh is defined and t.energy_wh is not none %}{{ "%.2f"|format(t.energy_wh / 1000) }} kWh{% elif t.live_energy_wh is defined and t.live_energy_wh is not none and t.active %}{{ "%.2f"|format(t.live_energy_wh / 1000) }} kWh <span class="{{ 'stale' if t.live_energy_stale else 'muted' }}">(estimada{% if t.live_energy_stale %}, antigua{% else %}, en vivo{% endif %})</span><div class="note muted">Medición: {{ t.live_energy_observed_at|display_date(timezone) if t.live_energy_observed_at else "Sin fecha" }}</div>{% elif t.active %}Final pendiente · estimación no disponible{% else %}—{% endif %}</td></tr>
{% else %}<tr><td class="empty" colspan="11">Sin transacciones</td></tr>{% endfor %}</tbody></table></div><nav class="transaction-pagination" aria-label="Páginas de transacciones">
<span class="muted note">Mostrando {{ ((tx_page - 1) * 10 + 1) if tx_total else 0 }}–{{ [tx_page * 10, tx_total]|min }} de {{ tx_total }} transacciones recientes</span>
<div class="transaction-pages">
{% if tx_page > 1 %}<a rel="prev" href="{{ request.url.include_query_params(tx_page=tx_page-1) }}#transactions" aria-label="Página anterior">Anterior</a>{% else %}<span class="page-disabled" aria-disabled="true">Anterior</span>{% endif %}
{% set first_page = [1, tx_page - 3]|max %}
{% set last_page = [tx_pages, first_page + 6]|min %}
{% set first_page = [1, last_page - 6]|max %}
{% if first_page > 1 %}<a href="{{ request.url.include_query_params(tx_page=1) }}#transactions" aria-label="Página 1">1</a>{% if first_page > 2 %}<span class="page-disabled" aria-hidden="true">…</span>{% endif %}{% endif %}
{% for p in range(first_page, last_page + 1) %}
{% if p == tx_page %}<span class="page-current" aria-current="page">{{ p }}</span>{% else %}<a href="{{ request.url.include_query_params(tx_page=p) }}#transactions" aria-label="Página {{ p }}">{{ p }}</a>{% endif %}
{% endfor %}
{% if last_page < tx_pages %}{% if last_page + 1 < tx_pages %}<span class="page-disabled" aria-hidden="true">…</span>{% endif %}<a href="{{ request.url.include_query_params(tx_page=tx_pages) }}#transactions" aria-label="Página {{ tx_pages }}">{{ tx_pages }}</a>{% endif %}
{% if tx_page < tx_pages %}<a rel="next" href="{{ request.url.include_query_params(tx_page=tx_page+1) }}#transactions" aria-label="Página siguiente">Siguiente</a>{% else %}<span class="page-disabled" aria-disabled="true">Siguiente</span>{% endif %}
</div></nav>
</section>
<section class="rfid-panel" id="rfid-cards"><div class="table-panel-heading"><div class="panel-heading"><h2>Tarjetas RFID</h2>{{ panel_help('Tarjetas RFID', 'Cargas: sesiones con energía final positiva. Energía: suma del consumo final registrado. Los totales respetan los filtros del dashboard, no la página ni la pestaña de sesiones.') }}</div></div><div class="scroll" tabindex="0" role="region" aria-label="Tabla de tarjetas RFID"><table><thead><tr><th>RFID</th><th class="numeric">Cargas</th><th class="numeric">Energía (kWh)</th></tr></thead><tbody>
{% for card in rfid_cards|default([]) %}<tr><td><a href="/rfid?{{ {'rfid': card.rfid, 'tz': timezone}|urlencode }}">{{ card.rfid }}</a></td><td class="numeric">{{ card.charges }}</td><td class="numeric">{{ "%.2f"|format(card.energy_kwh) }}</td></tr>{% else %}<tr><td class="empty" colspan="3">Sin tarjetas RFID</td></tr>{% endfor %}
</tbody></table></div></section>
{% if is_admin | default(true) %}
{% if login_enabled and is_admin %}
<section class="users-panel" id="dashboard-users" aria-labelledby="dashboard-users-heading">
<div class="table-panel-heading"><div class="panel-heading"><h2 id="dashboard-users-heading">Usuarios con acceso</h2>{{ panel_help('Usuarios con acceso', 'Cuentas autorizadas, permisos y último acceso registrado. Una cuenta activa puede iniciar sesión; no implica que esté conectada ahora. Administrar permite gestionar las cuentas según tus permisos.') }}</div><div class="table-panel-actions"><a href="/accounts">Administrar</a></div></div>
<div class="scroll" tabindex="0" role="region" aria-label="Usuarios autorizados para este dashboard">
<table><thead><tr><th>Usuario</th>{% if is_central_admin %}<th>Dashboard</th>{% endif %}<th>Permisos</th><th>Último acceso</th><th>Cuenta</th></tr></thead>
<tbody>{% for account in dashboard_accounts %}
<tr><td>{{ account.user_id }}</td>{% if is_central_admin %}<td>{{ account.tenant_id }}</td>{% endif %}<td>{{ account.role }}</td>
<td>{{ account.last_login_at|display_date(timezone) if account.last_login_at else 'Sin registro' }}</td>
<td>{{ 'Activa' if account.active else 'Deshabilitada' }}</td></tr>
{% else %}<tr><td class="empty" colspan="{{ 5 if is_central_admin else 4 }}">Sin usuarios registrados</td></tr>{% endfor %}</tbody>
</table></div></section>
{% endif %}
{% endif %}</div></main>

<div id="panel-help-tooltip" class="panel-help-tooltip" role="tooltip" hidden></div>
<dialog id="panel-help-dialog" class="panel-help-dialog" aria-labelledby="panel-help-title" aria-describedby="panel-help-description">
  <div class="panel-help-dialog-heading"><h2 id="panel-help-title"></h2><button type="button" class="panel-help-close" aria-label="Cerrar información" autofocus>×</button></div>
  <p id="panel-help-description"></p>
</dialog>

<script>
(() => {
  // Hover-capable desktop uses a tooltip; touch/compact screens use a modal.
  const desktopHelp = window.matchMedia("(hover: hover) and (pointer: fine) and (min-width: 521px)");
  const tooltip = document.getElementById("panel-help-tooltip");
  const help = document.getElementById("panel-help-dialog");
  const helpTitle = document.getElementById("panel-help-title");
  const helpText = document.getElementById("panel-help-description");
  const triggers = [...document.querySelectorAll(".panel-help-trigger")];
  let helpTrigger = null;
  let tooltipTrigger = null;
  const hideTooltip = () => {
    tooltip.hidden = true;
    tooltipTrigger?.removeAttribute("aria-describedby");
    tooltipTrigger = null;
  };
  const positionTooltip = () => {
    if (!tooltipTrigger) return;
    const r = tooltipTrigger.getBoundingClientRect();
    if (r.bottom < 0 || r.top > innerHeight) { hideTooltip(); return; }
    const w = tooltip.offsetWidth;
    const h = tooltip.offsetHeight;
    tooltip.style.left = Math.max(8, Math.min(r.left, innerWidth - w - 8)) + "px";
    tooltip.style.top = Math.max(8, Math.min(r.bottom + h <= innerHeight - 8 ?
      r.bottom : r.top - h, innerHeight - h - 8)) + "px";
  };
  const showTooltip = (trigger) => {
    if (!desktopHelp.matches || help.open) return;
    if (tooltipTrigger !== trigger) hideTooltip();
    tooltipTrigger = trigger;
    tooltip.textContent = trigger.dataset.helpText;
    trigger.setAttribute("aria-describedby", tooltip.id);
    tooltip.hidden = false;
    positionTooltip();
  };
  const updateHelpMode = () => {
    hideTooltip();
    for (const trigger of triggers) {
      if (desktopHelp.matches) {
        trigger.removeAttribute("aria-haspopup");
        trigger.removeAttribute("aria-controls");
      } else {
        trigger.setAttribute("aria-haspopup", "dialog");
        trigger.setAttribute("aria-controls", help.id);
      }
    }
  };
  updateHelpMode();
  desktopHelp.addEventListener("change", updateHelpMode);
  for (const trigger of triggers) {
    trigger.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "touch") showTooltip(trigger);
    });
    trigger.addEventListener("pointerleave", (event) => {
      if (tooltipTrigger === trigger && !tooltip.contains(event.relatedTarget) &&
          !trigger.matches(":focus-visible")) hideTooltip();
    });
    trigger.addEventListener("focus", () => {
      if (trigger.matches(":focus-visible")) showTooltip(trigger);
    });
    trigger.addEventListener("blur", () => {
      if (tooltipTrigger === trigger && !trigger.matches(":hover") && !tooltip.matches(":hover")) hideTooltip();
    });
    trigger.addEventListener("click", (event) => {
      if (desktopHelp.matches && event.pointerType !== "touch") { showTooltip(trigger); return; }
      if (help.open) return;
      hideTooltip();
      helpTrigger = trigger;
      helpTitle.textContent = trigger.dataset.helpTitle;
      helpText.textContent = trigger.dataset.helpText;
      help.showModal();
    });
  }
  tooltip.addEventListener("pointerleave", (event) => {
    if (tooltipTrigger && !tooltipTrigger.contains(event.relatedTarget) &&
        !tooltipTrigger.matches(":focus-visible")) hideTooltip();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !tooltip.hidden) hideTooltip();
  });
  window.addEventListener("resize", positionTooltip);
  window.addEventListener("scroll", positionTooltip, {passive: true, capture: true});
  help.querySelector(".panel-help-close").addEventListener("click", () => help.close());
  help.addEventListener("click", (event) => {
    if (event.target !== help) return;
    const bounds = help.getBoundingClientRect();
    if (event.clientX < bounds.left || event.clientX > bounds.right ||
        event.clientY < bounds.top || event.clientY > bounds.bottom) help.close();
  });
  help.addEventListener("close", () => {
    helpTrigger?.focus({preventScroll: true});
    helpTrigger = null;
  });

  const form = document.getElementById("dashboard-filters");
  const zoneChoice = document.getElementById("timezone-choice");
  const zoneHidden = document.getElementById("timezone-value");
  if (!form) return;
  const permitted = Array.from(zoneChoice.options, o => o.value);
  const query = new URLSearchParams(window.location.search);
  const stored = localStorage.getItem("ocpp-reports-dashboard-tz");
  // Explicit URL selection takes precedence, then saved preference, then instance default.
  const selection = query.has("tz") ? query.get("tz") : stored;
  if (selection && permitted.includes(selection) && selection !== zoneHidden.value) {
    const next = new URL(window.location.href);
    next.searchParams.set("tz", selection);
    window.location.replace(next.toString());
    return;
  }
  if (permitted.includes(zoneHidden.value)) localStorage.setItem("ocpp-reports-dashboard-tz", zoneHidden.value);
  zoneChoice.addEventListener("change", () => {
    if (!permitted.includes(zoneChoice.value)) return;
    localStorage.setItem("ocpp-reports-dashboard-tz", zoneChoice.value);
    zoneHidden.value = zoneChoice.value;
    const next = new URL(window.location.href);
    next.searchParams.set("tz", zoneChoice.value);
    window.location.assign(next.toString());
  });
  for (const button of document.querySelectorAll("[data-connector-view]")) {
    button.addEventListener("click", () => {
      const next = new URL(window.location.href);
      next.searchParams.set("connector_view", button.dataset.connectorView);
      next.hash = "connectors";
      window.location.assign(next.toString());
    });
  }
  for (const button of document.querySelectorAll("[data-tx-view]")) {
    button.addEventListener("click", () => {
      const next = new URL(window.location.href);
      next.searchParams.set("tx_view", button.dataset.txView);
      next.searchParams.delete("tx_page");
      if (button.dataset.txView === "active") {
        // An old success/date/search filter must not hide ongoing sessions.
        // Tenant permissions stay enforced by the authenticated route.
        for (const key of ["filter", "status", "location", "date_from", "date_to"]) {
          next.searchParams.delete(key);
        }
      }
      next.hash = "transactions";
      window.location.assign(next.toString());
    });
  }
  // Show a scroll affordance only when desktop connector columns actually overflow.
  const connectorRegion = document.querySelector(".connectors-panel .scroll");
  const connectorHint = document.getElementById("connector-scroll-hint");
  if (connectorRegion && connectorHint) {
    const updateConnectorHint = () => {
      const overflows = connectorRegion.scrollWidth > connectorRegion.clientWidth + 2;
      const atEnd = connectorRegion.scrollLeft + connectorRegion.clientWidth >= connectorRegion.scrollWidth - 2;
      connectorHint.hidden = !(window.innerWidth > 520 && overflows && !atEnd);
    };
    connectorRegion.addEventListener("scroll", updateConnectorHint, {passive: true});
    window.addEventListener("resize", updateConnectorHint);
    updateConnectorHint();
  }
  // Refresh data in place. Never navigate, replace table scroll containers,
  // or disturb filters, focused controls or scroll positions.
  // The existing GET route applies the same source permissions and URL filters.
  let refreshing = false;
  const refreshDashboard = async () => {
    if (refreshing || document.hidden) return;
    refreshing = true;
    try {
      const response = await fetch(window.location.pathname + window.location.search, {
        credentials: "same-origin", cache: "no-store",
        headers: {"Accept": "text/html"}
      });
      if (!response.ok) return; // Keep existing evidence on transient warehouse errors.
      const fresh = new DOMParser().parseFromString(await response.text(), "text/html");
      const update = (selector) => {
        const current = document.querySelector(selector);
        const next = fresh.querySelector(selector);
        if (current && next && current.innerHTML !== next.innerHTML &&
            !current.contains(document.activeElement)) {
          current.innerHTML = next.innerHTML;
        }
      };
      // Change only data surfaces, not panels or scrollable wrappers.
      for (const selector of [
        ".operations-cards",
        ".connectors-panel tbody",
        ".transactions-panel tbody",
        ".transactions-panel .transaction-pagination",
        ".rfid-panel tbody", ".users-panel tbody"
      ]) update(selector);
      // Update transaction counts without replacing the filter buttons: their
      // click listeners and current selection must survive every poll.
      for (const button of document.querySelectorAll(".transaction-filters [data-tx-view]")) {
        const view = button.dataset.txView;
        const next = fresh.querySelector('.transaction-filters [data-tx-view="' + view + '"]');
        if (next && button.textContent !== next.textContent) button.textContent = next.textContent;
      }
    } catch (_) {
      // A failed poll must not interrupt the dashboard or reset the page.
    } finally {
      refreshing = false;
    }
  };
  const refreshTimer = window.setInterval(refreshDashboard, 5000);
  window.addEventListener("pagehide", () => window.clearInterval(refreshTimer));

  let timer;
  const apply = () => { clearTimeout(timer); form.requestSubmit(); };
  for (const input of form.querySelectorAll('input:not([type="hidden"])')) {
    input.addEventListener("input", () => { clearTimeout(timer); timer = setTimeout(apply, 650); });
    input.addEventListener("change", apply);
  }
})();
</script>
</body></html>
