<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="refresh" content="15"><title>OCPP Reports</title>
<style>
:root{color-scheme:light dark;font:16px system-ui,sans-serif}body{max-width:1200px;margin:auto;padding:1.5rem}
header{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap}
section{margin:1.5rem 0}table{border-collapse:collapse;width:100%;font-size:.9rem}
th,td{text-align:left;padding:.65rem;border-bottom:1px solid #8885}th{font-weight:600}
.scroll{overflow:auto}.muted{opacity:.7}.stale{color:#bd7211;font-weight:600}
.cards{display:flex;gap:1rem;flex-wrap:wrap}.cards article{border:1px solid #8885;border-radius:12px;padding:1rem;min-width:140px}
input,button{padding:.5rem;margin:.2rem}
</style></head><body>
<header><div><h1>OCPP Reports</h1><p class="muted">Warehouse local · Solo lectura · Actualización cada 15 s</p></div>
<form method="get"><label>Origen <input name="source_id" value="{{ source_id }}" placeholder="Todos"></label>
<label>Cargador <input name="charger_id" value="{{ charger_id }}" placeholder="Todos"></label><button>Filtrar</button></form></header>
<section><h2>Resumen</h2><div class="cards">
<article><strong>{{ data.sources|length }}</strong><div>Orígenes</div></article>
<article><strong>{{ data.connectors|length }}</strong><div>Conectores</div></article>
<article><strong>{{ data.transactions|length }}</strong><div>Transacciones recientes</div></article>
<article><strong>{{ data.events|length }}</strong><div>Eventos recientes</div></article></div></section>
<section><h2>Sincronización</h2><div class="scroll"><table><thead><tr><th>Origen</th><th>Cursor</th><th>Última ingestión</th></tr></thead><tbody>
{% for s in data.sources %}<tr><td>{{ s.source_id }}</td><td>{{ s.cursor }}</td><td>{{ s.last_ingested_at or "Sin datos" }}</td></tr>{% else %}<tr><td colspan="3">Sin orígenes</td></tr>{% endfor %}
</tbody></table></div></section>
<section><h2>Conectores</h2><div class="scroll"><table><thead><tr><th>Origen</th><th>Cargador</th><th>Conector</th><th>Estado observado</th><th>Conectado*</th><th>Potencia</th><th>Energía registrada</th><th>Observado</th></tr></thead><tbody>
{% for c in data.connectors %}<tr><td>{{ c.source_id }}</td><td>{{ c.charger_id }}</td><td>{{ c.connector_id }}</td>
<td>{{ c.status or "Desconocido" }} {% if c.stale %}<span class="stale">· Antiguo</span>{% endif %}</td>
<td>{{ "Sí" if c.connected else "No" }}</td>
<td>{{ "%.2f"|format(c.power_w / 1000) ~ " kW" if c.power_w is not none else "—" }}</td>
<td>{{ "%.2f"|format(c.energy_wh / 1000) ~ " kWh" if c.energy_wh is not none else "—" }}</td><td>{{ c.observed_at }}</td></tr>
{% else %}<tr><td colspan="8">Sin conectores registrados</td></tr>{% endfor %}</tbody></table></div>
<p class="muted">* Última observación del productor, no una conexión en tiempo real. Energía registrada: lectura de medidor, no consumo de la sesión.</p></section>
<section><h2>Transacciones recientes</h2><div class="scroll"><table><thead><tr><th>Cargador</th><th>ID</th><th>Estado</th><th>Inicio</th><th>Fin</th><th>Energía de sesión</th></tr></thead><tbody>
{% for t in data.transactions %}<tr><td>{{ t.charger_id }}</td><td>{{ t.id }}</td><td>{{ t.state or "—" }}</td><td>{{ t.started_at or "—" }}</td><td>{{ t.stopped_at or "Activa / sin cierre" }}</td>
<td>{{ "%.2f"|format(t.energy_wh / 1000) ~ " kWh" if t.energy_wh is defined and t.energy_wh is not none else "—" }}</td></tr>
{% else %}<tr><td colspan="6">Sin transacciones</td></tr>{% endfor %}</tbody></table></div></section>
<section><h2>Eventos recientes</h2><div class="scroll"><table><thead><tr><th>ID</th><th>Cargador</th><th>Acción</th><th>Fecha</th></tr></thead><tbody>
{% for e in data.events %}<tr><td>{{ e.id }}</td><td>{{ e.charger_id }}</td><td>{{ e.action }}</td><td>{{ e.at }}</td></tr>
{% else %}<tr><td colspan="4">Sin eventos</td></tr>{% endfor %}</tbody></table></div></section>
</body></html>