<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="refresh" content="15"><title>{{ title }}</title>
<style>
:root{color-scheme:light;--bg:#f5f7fa;--surface:#fff;--ink:#172437;--muted:#637286;--line:#e2e8f0;--nav:#203247;--accent:#1268c7;--warning:#a96700;font:16px system-ui,sans-serif}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);line-height:1.45}
header{background:var(--nav);color:white;padding:1.2rem max(1.25rem,calc((100vw - 1280px)/2));display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
header h1{margin:0;font-size:1.55rem;letter-spacing:-.03em}header .muted{color:#d0dbe6;margin:.2rem 0 0}
main{max-width:1320px;margin:auto;padding:1.4rem 1.25rem 3rem}
.filters{display:flex;gap:.75rem;align-items:end;flex-wrap:wrap}.filters label{display:grid;gap:.25rem;font-size:.82rem;font-weight:600}
input,button{font:inherit;border:1px solid var(--line);border-radius:8px;padding:.55rem .75rem;min-height:40px}
button{background:var(--accent);border-color:var(--accent);color:white;font-weight:600;cursor:pointer}
button:hover{filter:brightness(.92)}input{background:white;min-width:140px}
section{margin:0 0 1.25rem;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:1.25rem;box-shadow:0 2px 10px #152c4608}
section h2{font-size:1.05rem;margin:0 0 1rem}.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:.87rem}th,td{text-align:left;padding:.75rem .65rem;border-bottom:1px solid var(--line);white-space:nowrap}th{font-weight:650;background:#f6f8fb;color:#34455a}tbody tr:last-child td{border-bottom:0}
.muted{color:var(--muted)}.stale{color:var(--warning);font-weight:650}
.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}
.cards article{border:1px solid var(--line);border-radius:11px;padding:1.1rem;background:#f8fbff;display:flex;flex-direction:column;gap:.3rem}
.cards article:nth-child(2){background:#f2faf7}.cards article:nth-child(3){background:#fffaf0}.cards article:nth-child(4){background:#f8f6ff}
.cards strong{font-size:2rem;line-height:1.1;font-variant-numeric:tabular-nums}.cards article div{color:var(--muted);font-size:.86rem}
.dashboard-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;align-items:start}.dashboard-grid section{min-width:0;margin:0}
.summary{margin-bottom:1.25rem}.summary h2{margin-bottom:.85rem}
@media(max-width:900px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.dashboard-grid{grid-template-columns:1fr}header{padding:1.1rem 1.25rem}}
@media(max-width:520px){.cards{gap:.6rem}.cards article{padding:.8rem}.cards strong{font-size:1.65rem}main{padding:1rem .75rem}section{padding:1rem}header{padding:1rem}.filters{width:100%}.filters label{flex:1;min-width:120px}.filters input{width:100%;min-width:0}}
@media(prefers-color-scheme:dark){:root{color-scheme:dark;--bg:#111923;--surface:#1b2734;--ink:#e8eef6;--muted:#a5b3c3;--line:#344557;--nav:#0c1520;--accent:#5da5f5;--warning:#ffbe60}input{background:#243345;color:var(--ink)}button{color:#0b1b2c}th{background:#263647;color:#d7e5f5}.cards article,.cards article:nth-child(n){background:#223245}}
.status{display:inline-flex;align-items:center;gap:.4rem;border-radius:999px;padding:.2rem .5rem;font-size:.78rem;font-weight:650;background:#edf1f5}.status::before{content:"";width:.5rem;height:.5rem;border-radius:50%;background:#8795a7}.status--ok{background:#e3f6ed;color:#087342}.status--ok::before{background:#0b9960}.status--active{background:#e4f0ff;color:#155bad}.status--active::before{background:#1976e9}.status--warn{background:#fff3d9;color:#906000}.status--warn::before{background:#dfa000}.status--off{background:#f7e8e8;color:#984545}.status--off::before{background:#c55b5b}.numeric{text-align:right;font-variant-numeric:tabular-nums}.empty{text-align:center;color:var(--muted);padding:1.5rem}.note{font-size:.8rem}@media(prefers-color-scheme:dark){.status{background:#354657;color:#e1e9f3}.status--ok{background:#164333;color:#9ce7c1}.status--active{background:#193c62;color:#a9d4ff}.status--warn{background:#493c20;color:#ffe1a3}.status--off{background:#493039;color:#ffc0c7}}.clear-filters{color:var(--accent);padding:.55rem .4rem;font-size:.9rem;font-weight:600;text-decoration:none}.clear-filters:hover{text-decoration:underline}.skip-link{position:absolute;left:1rem;top:-5rem;background:white;color:#172437;padding:.6rem 1rem;z-index:10;border-radius:6px}.skip-link:focus{top:.5rem}a:focus-visible,button:focus-visible,input:focus-visible,.scroll:focus-visible{outline:3px solid var(--accent);outline-offset:3px}@media(max-width:520px){.filters button,.clear-filters{flex:1;text-align:center}.scroll{max-width:100%}th,td{padding:.65rem .55rem}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}
/* Operational summary: show actionable charger conditions before technical data. */
.operations{margin-bottom:.8rem}.operations h2{margin-bottom:.3rem}.operations .note{margin:.2rem 0 .7rem}
.operations-cards{gap:.65rem}.operational-card{display:flex;flex-direction:column;gap:.25rem;min-width:0;padding:.85rem 1rem;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--ink);text-decoration:none}
.operational-card strong{font-size:1.65rem;line-height:1.1;font-variant-numeric:tabular-nums}.operational-card span{font-size:.82rem;color:var(--muted)}
.operational-card--available{border-left:4px solid #19975b}.operational-card--charging{border-left:4px solid #dba520}.operational-card--fault{border-left:4px solid #b94d4d}.operational-card--uncertain{border-left:4px solid #8994a3}.operational-card:hover,.operational-card:focus-visible{border-color:var(--accent);text-decoration:underline}
.filter-panel h2{margin-bottom:.6rem}.filter-panel{padding:.85rem 1.25rem}
.dashboard-grid .connectors-panel{grid-column:1/-1}.charger-identity{overflow-wrap:anywhere}
@media(max-width:520px){
header{padding:.65rem .9rem}header h1{font-size:1.12rem}header .muted{font-size:.76rem;margin:0}
main{padding:.65rem}.operations{padding:.8rem}.operations .note{font-size:.73rem}
.operations-cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:.4rem}.operational-card{padding:.6rem;min-height:76px}.operational-card strong{font-size:1.45rem}.operational-card span{font-size:.75rem}
.filter-panel{padding:.75rem}.dashboard-grid .connectors-panel .scroll{overflow:visible}
.connectors-panel table,.connectors-panel tbody,.connectors-panel tr,.connectors-panel td{display:block;width:100%}
.connectors-panel thead{display:none}.connectors-panel tbody tr{margin-bottom:.65rem;border:1px solid var(--line);border-radius:9px;padding:.55rem;background:var(--surface)}
.connectors-panel td{white-space:normal;padding:.25rem .1rem;border:0;display:flex;justify-content:space-between;align-items:start;gap:.6rem;text-align:right;overflow-wrap:anywhere;font-size:.8rem}
.connectors-panel td::before{content:attr(data-label);font-size:.75rem;color:var(--muted);font-weight:650;text-align:left;flex:0 0 35%}
.connectors-panel td.empty{display:block;text-align:center}.connectors-panel td.empty::before{content:none}
}

/* Compact filters in the navigation/header, responsive without a separate panel. */
header .brand{min-width:0}
.header-filters{margin-left:auto;align-items:end;gap:.5rem}
.header-filters label{color:#d0dbe6;font-size:.75rem}
.header-filters input{width:155px;min-width:0;min-height:36px;font-size:.85rem;padding:.4rem .55rem}
.header-filters .clear-filters{color:#e0ebfa;white-space:nowrap;padding:.35rem .2rem}
@media(max-width:700px){
header{align-items:start;gap:.65rem}
.header-filters{margin:0;width:100%;flex-wrap:nowrap}
.header-filters label{flex:1;min-width:0}
.header-filters input{width:100%}
.header-filters .clear-filters{align-self:end}
}

/* Full-width transaction evidence; compact supporting operations below. */
.dashboard-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;align-items:start}
.dashboard-grid .connectors-panel,.dashboard-grid .transactions-panel{grid-column:1/-1}
.dashboard-grid .events-panel{grid-column:2;grid-row:auto}
.dashboard-grid .sync-panel{grid-column:1;grid-row:auto}
.dashboard-grid section{margin:0;min-width:0}
.header-filters .unified-filter{width:min(390px,38vw);min-width:245px}
.header-filters{margin-left:auto}
.tz-picker{position:relative;display:inline-block}
.tz-picker summary{cursor:pointer;text-decoration:underline;text-underline-offset:2px;list-style:none;color:#d8e8fa}
.tz-picker summary::-webkit-details-marker{display:none}
.tz-picker select{min-width:150px;max-width:235px;background:#fff;color:#172437;border:1px solid #a4b0bd;border-radius:6px}
.events-panel details{padding:.5rem .2rem;border-bottom:1px solid var(--line)}
.events-panel details summary{cursor:pointer;font-weight:600}
.events-panel details[open] summary{padding-bottom:.5rem}
.events-panel .scroll{max-height:340px;overflow:auto}
.transactions-panel .scroll{max-width:100%}
@media(max-width:1100px){.header-filters{width:100%;justify-content:start}.dashboard-grid{grid-template-columns:1fr}.dashboard-grid section,.dashboard-grid .connectors-panel,.dashboard-grid .transactions-panel,.dashboard-grid .events-panel,.dashboard-grid .sync-panel{grid-column:1}}
@media(max-width:700px){.header-filters{flex-wrap:wrap}.header-filters label{flex:1 1 100%}.header-filters .unified-filter{width:100%;min-width:0}}

.transaction-pagination{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem;margin-top:.75rem}
.transaction-pages{display:flex;align-items:center;gap:.25rem;flex-wrap:wrap}
.transaction-pages a,.transaction-pages span.page-current,.transaction-pages span.page-disabled{display:inline-flex;min-width:2rem;min-height:2rem;align-items:center;justify-content:center;padding:.2rem .5rem;border-radius:.4rem;text-decoration:none;font-size:.86rem}
.transaction-pages a{color:var(--accent);border:1px solid var(--line)}
.transaction-pages a:hover{background:var(--bg)}
.transaction-pages .page-current{background:var(--accent);color:var(--surface);font-weight:700}
.transaction-pages .page-disabled{color:var(--muted);opacity:.65}
.transactions-heading{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:1rem}
.transactions-heading h2{margin:0}
.transaction-filters,.connector-filters{display:inline-flex;align-items:center;gap:.35rem;white-space:nowrap;font-size:.85rem}
.transaction-filters button,.connector-filters button{border:0;background:transparent;color:var(--muted);font-size:inherit;font-weight:500;padding:.2rem .3rem;min-height:32px}
.transaction-filters button.selected,.connector-filters button.selected{color:var(--accent);font-weight:750;text-decoration:underline;text-underline-offset:4px}
.transaction-filters button:hover,.connector-filters button:hover{color:var(--accent)}
.transaction-filters span,.connector-filters span{color:var(--muted)}
</style></head><body>
<a class="skip-link" href="#content">Ir al contenido</a><header><div class="brand"><h1>{{ title }}</h1>
<div class="muted">Estado de cargadores · Solo lectura · Página actualizada cada 15 s ·
<details class="tz-picker"><summary id="timezone-display">{{ timezone }} ▾</summary>
<label for="timezone-choice">Zona horaria</label>
<select id="timezone-choice" aria-label="Zona horaria">{% for zone in timezones %}
<option value="{{ zone }}" {{ 'selected' if timezone == zone else '' }}>{{ zone }}</option>{% endfor %}</select></details></div></div>
<form id="dashboard-filters" class="filters header-filters" method="get" action="/" role="search" aria-label="Filtrar datos del dashboard">
<label for="dashboard-search">Filtrar <input id="dashboard-search" class="unified-filter" type="search" name="filter" value="{{ filter }}" placeholder="Origen, cargador, ubicación o estado" autocomplete="off"></label>
<input type="hidden" name="tz" id="timezone-value" value="{{ timezone }}">
<input type="hidden" name="tx_view" value="{{ tx_view }}">
<input type="hidden" name="connector_view" value="{{ connector_view }}">
</form>
</header><main id="content">
{% set counts = namespace(faults=0, charging=0, available=0, uncertain=0) %}
{% for c in data.connectors %}
  {% set state = (c.status or '')|lower %}
  {% if state in ['faulted', 'unavailable'] %}{% set counts.faults = counts.faults + 1 %}{% endif %}
  {% if c.stale or not c.status %}{% set counts.uncertain = counts.uncertain + 1 %}
  {% elif state == 'charging' %}{% set counts.charging = counts.charging + 1 %}
  {% elif state == 'available' %}{% set counts.available = counts.available + 1 %}
  {% elif state not in ['faulted', 'unavailable'] %}{% set counts.uncertain = counts.uncertain + 1 %}{% endif %}
{% endfor %}
<section class="operations" aria-labelledby="operations-heading">
<h2 id="operations-heading">Estado de los cargadores</h2>
<p class="muted note">Último estado informado, no conectividad en tiempo real. Una falla antigua también puede contarse como dato antiguo.</p>
<div class="cards operations-cards">
<a class="operational-card operational-card--available" href="#connectors"><strong>{{ counts.available }}</strong><span>Disponibles</span></a>
<a class="operational-card operational-card--charging" href="#connectors"><strong>{{ counts.charging }}</strong><span>Cargando</span></a>
<a class="operational-card operational-card--fault" href="#connectors"><strong>{{ counts.faults }}</strong><span>Falla / no disponible (último estado)</span></a>
<a class="operational-card operational-card--uncertain" href="#connectors"><strong>{{ counts.uncertain }}</strong><span>Datos antiguos / otros</span></a>
</div></section>

<div class="dashboard-grid"><section id="connectors" class="connectors-panel"><div class="transactions-heading"><h2>Conectores</h2>
<div class="connector-filters" role="group" aria-label="Filtrar conectores">
<button type="button" data-connector-view="combined" aria-pressed="{{ 'true' if connector_view == 'combined' else 'false' }}" class="{{ 'selected' if connector_view == 'combined' else '' }}">Combinado</button>
<span aria-hidden="true">|</span>
<button type="button" data-connector-view="station" aria-pressed="{{ 'true' if connector_view == 'station' else 'false' }}" class="{{ 'selected' if connector_view == 'station' else '' }}">Estación</button>
<span aria-hidden="true">|</span>
<button type="button" data-connector-view="individual" aria-pressed="{{ 'true' if connector_view == 'individual' else 'false' }}" class="{{ 'selected' if connector_view == 'individual' else '' }}">Individual</button>
</div></div><div class="scroll" tabindex="0" role="region" aria-label="Tabla de conectores"><table><thead><tr><th>Ubicación</th><th>Cargador</th><th>Conector</th><th>Estado observado</th><th>Conectado*</th><th>Potencia</th><th>Energía registrada</th><th>Snapshot recibido</th></tr></thead><tbody>
{% for c in connector_rows %}<tr><td data-label="Ubicación">{{ c.location }}</td><td data-label="Cargador" class="charger-identity">{{ c.charger_id }}</td><td data-label="Conector">{{ c.connector_id }}</td>
<td data-label="Estado">{% set state = (c.status or "")|lower %}<span class="status {% if state == 'charging' %}status--active{% elif state in ['available', 'finishing'] %}status--ok{% elif state in ['preparing', 'suspendedev', 'suspendedevse'] %}status--warn{% elif state in ['faulted', 'unavailable'] %}status--off{% endif %}">{{ c.status or "Desconocido" }}</span>{% if c.stale %} <span class="status status--warn">Antiguo</span>{% endif %}</td>
<td data-label="Conectado"><span class="status {{ 'status--ok' if c.connected else 'status--off' }}">{{ "Sí" if c.connected else "No" }} (observado)</span></td>
<td data-label="Potencia" class="numeric">{% if c.power_fresh and c.power_w is not none %}{{ "%.2f"|format(c.power_w / 1000) }} kW <span class="note muted" title="Power.Active.Import: medición reciente">medida</span>{% elif c.rated_power_w is defined and c.rated_power_w is not none %}{{ "%.2f"|format(c.rated_power_w / 1000) }} kW <span class="note muted" title="{{ 'Capacidad nominal del cargador, compartida; no es potencia medida' if c.connector_id == 0 or c.rating_scope == 'charger' else 'Capacidad nominal específica del conector; no es potencia medida' }}">nominal</span>{% else %}—{% endif %}</td>
<td data-label="Medidor" class="numeric">{{ "%.2f"|format(c.energy_wh / 1000) ~ " kWh" if c.energy_wh is not none else "—" }}</td><td data-label="Snapshot recibido">{{ c.observed_at|display_date(timezone) }}</td></tr>
{% else %}<tr><td class="empty" colspan="8">Sin conectores registrados</td></tr>{% endfor %}</tbody></table></div>
<p class="muted note">* Última observación del productor, no una conexión en tiempo real. Potencia: medida reciente o nominal configurada en CSMS (no es consumo actual). La capacidad de C0 es compartida y no debe sumarse con la de los conectores. Energía registrada: lectura de medidor, no consumo de la sesión. Las fechas originales de estado permanecen en la API.</p></section>
<section class="transactions-panel" id="transactions"><div class="transactions-heading"><h2>Transacciones recientes</h2>
<div class="transaction-filters" role="group" aria-label="Filtrar transacciones por energía final">
<button type="button" data-tx-view="success" aria-pressed="{{ 'true' if tx_view == 'success' else 'false' }}" class="{{ 'selected' if tx_view == 'success' else '' }}">Exitosas ({{ transaction_counts["success"] }})</button>
<span aria-hidden="true">|</span>
<button type="button" data-tx-view="failed" aria-pressed="{{ 'true' if tx_view == 'failed' else 'false' }}" class="{{ 'selected' if tx_view == 'failed' else '' }}">Fallidas ({{ transaction_counts["failed"] }})</button>
<span aria-hidden="true">|</span>
<button type="button" data-tx-view="all" aria-pressed="{{ 'true' if tx_view == 'all' else 'false' }}" class="{{ 'selected' if tx_view == 'all' else '' }}">Todas ({{ transaction_counts["all"] }})</button>
</div></div><div class="scroll" tabindex="0" role="region" aria-label="Tabla de transacciones recientes"><table><thead><tr><th>Ubicación</th><th>Cargador</th><th>ID</th><th>Estado</th><th>Inicio</th><th>Fin</th><th>Duración</th><th title="Primera lectura SoC recibida">SoC inicial</th><th title="Última lectura SoC recibida; no necesariamente al detener">SoC último</th><th>Energía de sesión</th></tr></thead><tbody>
{% for t in data.transactions %}<tr><td>{{ t.location }}</td><td>{{ t.charger_id }}</td><td>{{ t.id }}</td><td><span class="status {{ 'status--active' if (t.state or '')|lower in ['open', 'active', 'charging'] else 'status--ok' if (t.state or '')|lower in ['closed', 'stopped', 'completed'] else '' }}">{{ t.state or "Desconocido" }}</span></td><td>{{ t.started_at|display_date(timezone) }}</td><td>{{ t.stopped_at|display_date(timezone) if t.stopped_at else "Activa / sin cierre" }}</td><td>{{ t.started_at|session_duration(t.stopped_at) }}</td>
<td class="numeric">{{ (t.soc_start|string ~ '%') if t.soc_start is defined and t.soc_start is not none else '—' }}</td>
<td class="numeric">{{ (t.soc_end|string ~ '%') if t.soc_end is defined and t.soc_end is not none else '—' }}</td>
<td class="numeric">{% if t.energy_wh is defined and t.energy_wh is not none %}{{ "%.2f"|format(t.energy_wh / 1000) }} kWh (final){% elif t.live_energy_wh is defined and t.live_energy_wh is not none and t.active %}{{ "%.2f"|format(t.live_energy_wh / 1000) }} kWh <span class="{{ 'stale' if t.live_energy_stale else 'muted' }}">(estimada{% if t.live_energy_stale %}, antigua{% else %}, en vivo{% endif %})</span><div class="note muted">Medición: {{ t.live_energy_observed_at|display_date(timezone) if t.live_energy_observed_at else "Sin fecha" }}</div>{% elif t.active %}Final pendiente · estimación no disponible{% else %}—{% endif %}</td></tr>
{% else %}<tr><td class="empty" colspan="10">Sin transacciones</td></tr>{% endfor %}</tbody></table></div><nav class="transaction-pagination" aria-label="Páginas de transacciones">
<span class="muted note">Mostrando {{ ((tx_page - 1) * 20 + 1) if tx_total else 0 }}–{{ [tx_page * 20, tx_total]|min }} de {{ tx_total }} transacciones recientes</span>
<div class="transaction-pages">
{% if tx_page > 1 %}<a rel="prev" href="{{ request.url.include_query_params(tx_page=tx_page-1) }}#transactions" aria-label="Página anterior">Anterior</a>{% else %}<span class="page-disabled" aria-disabled="true">Anterior</span>{% endif %}
{% set first_page = [1, tx_page - 3]|max %}
{% set last_page = [tx_pages, first_page + 6]|min %}
{% set first_page = [1, last_page - 6]|max %}
{% if first_page > 1 %}<a href="{{ request.url.include_query_params(tx_page=1) }}#transactions" aria-label="Página 1">1</a>{% if first_page > 2 %}<span class="page-disabled" aria-hidden="true">…</span>{% endif %}{% endif %}
{% for p in range(first_page, last_page + 1) %}
{% if p == tx_page %}<span class="page-current" aria-current="page">{{ p }}</span>{% else %}<a href="{{ request.url.include_query_params(tx_page=p) }}#transactions" aria-label="Página {{ p }}">{{ p }}</a>{% endif %}
{% endfor %}
{% if last_page < tx_pages %}{% if last_page + 1 < tx_pages %}<span class="page-disabled" aria-hidden="true">…</span>{% endif %}<a href="{{ request.url.include_query_params(tx_page=tx_pages) }}#transactions" aria-label="Página {{ tx_pages }}">{{ tx_pages }}</a>{% endif %}
{% if tx_page < tx_pages %}<a rel="next" href="{{ request.url.include_query_params(tx_page=tx_page+1) }}#transactions" aria-label="Página siguiente">Siguiente</a>{% else %}<span class="page-disabled" aria-disabled="true">Siguiente</span>{% endif %}
</div></nav>
<p class="muted note">SoC: primera y última medición reportada; no se estiman valores ni se presupone una medición al cierre.</p></section>
<section class="sync-panel" id="synchronization"><h2>Sincronización</h2><p class="muted note">Ingestión local y recepción de réplica son distintas. La recarga de la página no confirma datos nuevos del cargador.</p><div class="scroll" tabindex="0" role="region" aria-label="Tabla de sincronización"><table><thead><tr><th>Origen</th><th>Cursor</th><th>Ingestión local</th><th>Recepción de réplica</th></tr></thead><tbody>
{% for s in data.sources %}<tr><td>{{ s.source_id }}</td><td>{{ s.cursor }}</td><td>{{ s.last_ingested_at|display_date(timezone) if s.last_ingested_at else "No aplica / desconocido" }}</td><td>{{ s.last_replication_received_at|display_date(timezone) if s.last_replication_received_at else "No aplica / desconocido" }}</td></tr>{% else %}<tr><td class="empty" colspan="4">Sin orígenes</td></tr>{% endfor %}
</tbody></table></div></section>
<section class="events-panel" id="events"><h2>Eventos recientes</h2>
<p class="muted note">Eventos consecutivos de la misma acción y cargador se agrupan; abre un grupo para ver el detalle.</p>
{% for group in event_groups %}
{% if group.first_event_id is defined %}
<details class="event-group" data-source="{{ group.source_id }}" data-first-id="{{ group.first_event_id }}">
<summary>{{ group.location or group.source_id }} · {{ group.action or 'Sin acción' }}
{% if group.event_count > 1 %}× {{ group.event_count }}{% endif %}
<span class="muted note"> · {{ group.at|display_date(timezone) }}</span></summary>
<div class="event-detail"><p class="muted note">Abre el grupo para consultar sus eventos.</p></div></details>
{% else %}
<details><summary>{{ group.location or group.source_id }} · {{ group.action or 'Sin acción' }}
{% if group["items"]|length > 1 %}× {{ group["items"]|length }}{% endif %}
<span class="muted note"> · {{ group["items"][0].at|display_date(timezone) }}</span></summary>
<div class="scroll"><table><thead><tr><th>ID</th><th>Ubicación</th><th>Cargador</th><th>Acción</th><th>Fecha</th></tr></thead><tbody>
{% for e in group["items"] %}<tr><td>{{ e.id }}</td><td>{{ e.location }}</td><td>{{ e.charger_id }}</td>
<td>{{ e.action }}</td><td>{{ e.at|display_date(timezone) }}</td></tr>{% endfor %}
</tbody></table></div></details>
{% endif %}
{% else %}<p class="muted">Sin eventos</p>{% endfor %}
<nav class="transaction-pagination" aria-label="Páginas de eventos">
<div class="transaction-pages">
{% if event_page > 1 %}<a href="{{ request.url.include_query_params(event_page=event_page-1) }}#events" rel="prev">Anterior</a>{% else %}<span class="page-disabled">Anterior</span>{% endif %}
<span class="page-current" aria-current="page">{{ event_page }}</span>
{% if event_has_next %}<a href="{{ request.url.include_query_params(event_page=event_page+1) }}#events" rel="next">Siguiente</a>{% else %}<span class="page-disabled">Siguiente</span>{% endif %}
</div></nav>
</section></div></main>

<script>
(() => {
  const form = document.getElementById("dashboard-filters");
  const zoneChoice = document.getElementById("timezone-choice");
  const zoneHidden = document.getElementById("timezone-value");
  if (!form) return;
  const permitted = Array.from(zoneChoice.options, o => o.value);
  const query = new URLSearchParams(window.location.search);
  const stored = localStorage.getItem("ocpp-reports-dashboard-tz");
  // Explicit URL selection takes precedence, then saved preference, then instance default.
  const selection = query.has("tz") ? query.get("tz") : stored;
  if (selection && permitted.includes(selection) && selection !== zoneHidden.value) {
    const next = new URL(window.location.href);
    next.searchParams.set("tz", selection);
    window.location.replace(next.toString());
    return;
  }
  if (permitted.includes(zoneHidden.value)) localStorage.setItem("ocpp-reports-dashboard-tz", zoneHidden.value);
  zoneChoice.addEventListener("change", () => {
    if (!permitted.includes(zoneChoice.value)) return;
    localStorage.setItem("ocpp-reports-dashboard-tz", zoneChoice.value);
    zoneHidden.value = zoneChoice.value;
    const next = new URL(window.location.href);
    next.searchParams.set("tz", zoneChoice.value);
    window.location.assign(next.toString());
  });
  for (const button of document.querySelectorAll("[data-connector-view]")) {
    button.addEventListener("click", () => {
      const next = new URL(window.location.href);
      next.searchParams.set("connector_view", button.dataset.connectorView);
      next.hash = "connectors";
      window.location.assign(next.toString());
    });
  }
  for (const button of document.querySelectorAll("[data-tx-view]")) {
    button.addEventListener("click", () => {
      const next = new URL(window.location.href);
      next.searchParams.set("tx_view", button.dataset.txView);
      next.searchParams.delete("tx_page");
      next.hash = "transactions";
      window.location.assign(next.toString());
    });
  }
  // Opening a group requests at most 50 original events. No event payloads
  // are embedded in the initial HTML; all DOM fields use textContent.
  for (const details of document.querySelectorAll(".event-group")) {
    const holder = details.querySelector(".event-detail");
    let offset = 0, exhausted = false, loading = false;
    const table = document.createElement("table");
    const body = document.createElement("tbody");
    const header = document.createElement("thead");
    const headRow = document.createElement("tr");
    for (const label of ["ID", "Ubicación", "Cargador", "Acción", "Fecha"]) {
      const th = document.createElement("th"); th.textContent = label; headRow.append(th);
    }
    header.append(headRow); table.append(header, body);
    const wrapper = document.createElement("div"); wrapper.className = "scroll"; wrapper.append(table);
    const more = document.createElement("button"); more.type = "button"; more.textContent = "Ver 50 más";
    const status = document.createElement("p"); status.className = "muted note";
    holder.replaceChildren(wrapper, status, more);
    const load = async () => {
      if (loading || exhausted) return;
      loading = true; more.disabled = true; status.textContent = "Cargando eventos…";
      const url = new URL("/api/event-group", window.location.origin);
      const args = new URLSearchParams(window.location.search);
      for (const [key, value] of args) url.searchParams.set(key, value);
      url.searchParams.set("group_source", details.dataset.source);
      url.searchParams.set("first_event_id", details.dataset.firstId);
      url.searchParams.set("offset", String(offset));
      try {
        const response = await fetch(url, {credentials: "same-origin"});
        if (!response.ok) throw new Error("HTTP " + response.status);
        const page = await response.json();
        for (const event of page.events) {
          const tr = document.createElement("tr");
          for (const value of [event.id, event.location, event.charger_id, event.action, event.display_at]) {
            const td = document.createElement("td"); td.textContent = value == null ? "—" : String(value);
            tr.append(td);
          }
          body.append(tr);
        }
        offset += page.events.length;
        exhausted = !page.has_next;
        more.hidden = exhausted;
        status.textContent = offset + " eventos cargados";
      } catch (_) {
        status.textContent = "No se pudieron cargar los eventos. Reintentar.";
      } finally {
        loading = false; more.disabled = false;
      }
    };
    more.addEventListener("click", load);
    details.addEventListener("toggle", () => {
      if (details.open && offset === 0) load();
    });
  }
  let timer;
  const apply = () => { clearTimeout(timer); form.requestSubmit(); };
  for (const input of form.querySelectorAll('input:not([type="hidden"])')) {
    input.addEventListener("input", () => { clearTimeout(timer); timer = setTimeout(apply, 650); });
    input.addEventListener("change", apply);
  }
})();
</script>
</body></html>
