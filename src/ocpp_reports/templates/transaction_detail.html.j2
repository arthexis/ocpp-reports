<!doctype html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Transacción #{{ transaction.id }} · {{ title }}</title>
{% include "favicon_links.html.j2" %}
{% from "detail_header.html.j2" import detail_header %}
<style>
{% include "detail_header.css.j2" %}
/* Same design tokens and chrome as the Reports dashboard. */
:root{color-scheme:light;--bg:#f5f7fa;--surface:#fff;--ink:#172437;--muted:#637286;--line:#e2e8f0;--nav:#203247;--accent:#1268c7;--warning:#a96700;font:16px system-ui,sans-serif}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);line-height:1.45}
a{color:var(--accent)}a:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.skip-link{position:absolute;left:1rem;top:-5rem;background:white;color:#172437;padding:.6rem 1rem;z-index:10;border-radius:6px}
.skip-link:focus{top:.5rem}
main{max-width:960px;margin:auto;padding:1.4rem 1.25rem 3rem}
.detail-heading,section.card{margin:0 0 1rem;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:1.25rem;box-shadow:0 2px 10px #152c4608}
.detail-heading h2{margin:0 0 .4rem;font-size:1.55rem;letter-spacing:-.03em;overflow-wrap:anywhere}
.detail-heading p{margin:.35rem 0}
.note{font-size:.83rem;color:var(--muted)}
.stale{color:var(--warning);font-weight:650}
.overview{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr) minmax(0,1fr);gap:1rem;margin-bottom:1rem;align-items:stretch}
.overview>.detail-heading,.overview>section.card{margin:0;min-width:0}
.soc-values{display:flex;align-items:baseline;gap:1rem;flex-wrap:wrap}
.soc-start{font-size:1.6rem;font-weight:650;line-height:1.2;font-variant-numeric:tabular-nums}
.soc-end{font-size:2rem;font-weight:750;line-height:1.15;font-variant-numeric:tabular-nums}
.soc-values .note{display:block;font-size:.75rem}
.overview .card{min-width:0;overflow-wrap:anywhere}
.card h2{font-size:1.05rem;margin:0 0 1rem}
.card .metric-label{color:var(--muted);font-size:.86rem;font-weight:600;margin-bottom:.35rem}
.big{font-size:2rem;line-height:1.15;font-weight:750;font-variant-numeric:tabular-nums;margin:.15rem 0 .6rem}
.card .note+.note{margin-top:.35rem}
.status{display:inline-flex;align-items:center;gap:.4rem;border-radius:999px;padding:.3rem .55rem;font-size:.82rem;font-weight:650;background:#edf1f5}
.status::before{content:"";width:.5rem;height:.5rem;border-radius:50%;background:#8795a7}
.status--active{background:#e4f0ff;color:#155bad}.status--active::before{background:#1976e9}
.status--ok{background:#e3f6ed;color:#087342}.status--ok::before{background:#0b9960}
.status--historic{background:#e9edf2;color:#4c5969}.status--historic::before{background:#7c8998}
.refresh-note{margin-left:.4rem}
.session-details{margin-top:1rem!important}
.session-details dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem 1rem;margin:0}
dl>div{min-width:0;border-bottom:1px solid var(--line);padding-bottom:.65rem}
dt{font-size:.82rem;color:var(--muted)}dd{margin:.15rem 0 0;font-weight:600;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}
@media(max-width:900px){.overview{grid-template-columns:1fr 1fr}.overview>.detail-heading{grid-column:1/-1}.session-details dl{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:540px){main{padding:.65rem}.detail-heading,section.card{padding:1rem}.overview{grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem}.overview>.detail-heading{grid-column:1/-1}.overview>section.card{padding:.8rem;min-width:0}.overview .metric-label{font-size:.78rem}.overview .soc-values{gap:.25rem .5rem}.soc-start{font-size:1.25rem}.soc-end{font-size:1.45rem}.big{font-size:clamp(1.25rem,5.2vw,1.65rem)}.session-details dl{grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem}.detail-heading h2{font-size:1.3rem}}
@media(prefers-color-scheme:dark){:root{color-scheme:dark;--bg:#111923;--surface:#1b2734;--ink:#e8eef6;--muted:#a5b3c3;--line:#344557;--nav:#0c1520;--accent:#5da5f5;--warning:#ffbe60}.status{background:#354657;color:#e1e9f3}.status--active{background:#193c62;color:#a9d4ff}.status--ok{background:#164333;color:#9ce7c1}.status--historic{background:#364354;color:#c1cbd8}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}

/* #215: dashboard-aligned full-width transaction timeline and evidence cards. */
main{max-width:1320px}
.timeline-card{margin:0 0 1rem;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:1.25rem;box-shadow:0 2px 10px #152c4608}
.timeline-card h2{font-size:1.05rem;margin:0 0 .5rem}
.timeline-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:1rem}
.timeline-plot{border:1px solid var(--line);border-radius:10px;padding:.75rem;min-width:0}
.timeline-plot h3{font-size:.95rem;margin:0 0 .4rem}
.timeline-plot svg{width:100%;height:auto;display:block;color:var(--accent)}
.timeline-plot polyline{fill:none;stroke:currentColor;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
.timeline-plot circle{fill:var(--accent);stroke:var(--surface);stroke-width:1.5}
.timeline-segment{stroke:var(--accent);stroke-width:2.5;stroke-linecap:round}
.timeline-plot .axis{stroke:var(--muted);stroke-width:1;opacity:.55}
.timeline-evidence{max-height:14rem;overflow:auto;border:1px solid var(--line);border-radius:8px}
.timeline-evidence table{width:100%;border-collapse:collapse;font-size:.83rem}
.timeline-evidence th,.timeline-evidence td{padding:.45rem;text-align:left;border-bottom:1px solid var(--line)}
.timeline-evidence th{position:sticky;top:0;background:var(--surface)}
.timeline-empty{padding:1rem;background:var(--bg);border-radius:8px;color:var(--muted)}
@media(max-width:540px){.timeline-card{padding:.8rem}.timeline-plot{padding:.5rem}}
{% include "page_geometry.css.j2" %}
</style></head><body>
<a class="skip-link" href="#content">Ir al contenido</a>
{{ detail_header(title, back_href|default('/?tz=' ~ (timezone|urlencode) ~ '#transactions'), subtitle='Panel de sesiones · Solo lectura' ~ (' · Consulta cada 15 s' if refresh_active else ''), logo_url=brand_image_url) }}
<main id="content" data-transaction-detail="true" data-active="{{ 'true' if refresh_active else 'false' }}">
<div class="overview">
<section class="detail-heading" aria-labelledby="transaction-heading">
<h2 id="transaction-heading">Transacción #{{ transaction.id }}</h2>
<p class="note">{{ transaction.location }} · {{ transaction.charger_id }} · Conector {{ transaction.connector_id if transaction.connector_id is defined and transaction.connector_id is not none else "desconocido" }}</p>
<p id="transaction-status" aria-live="polite"><span class="status {{ 'status--active' if refresh_active else 'status--ok' if (transaction.state or '')|lower in ['closed','stopped','completed'] else 'status--historic' }}">{{ transaction.state or "Desconocido" }}</span>
{% if refresh_active %}<span class="note refresh-note">En curso · consulta cada 15 s</span>{% endif %}</p>
</section>
<section class="card" id="transaction-energy" aria-label="Energía de sesión"><div class="metric-label">Energía de sesión</div>
{% if transaction.energy_wh is defined and transaction.energy_wh is not none %}
<div class="big">{{ "%.2f"|format(transaction.energy_wh / 1000) }} kWh</div>
<div class="note">Final · medición al cierre</div>
{% elif refresh_active and transaction.live_energy_wh is defined and transaction.live_energy_wh is not none %}
<div class="big" title="Estimada{% if transaction.live_energy_stale %} · medición antigua / no verificada{% else %} · medición reciente{% endif %}">{{ "%.2f"|format(transaction.live_energy_wh / 1000) }} kWh</div>
<div class="note">Última medición: {{ transaction.live_energy_observed_at|display_date(timezone) if transaction.live_energy_observed_at else "Desconocida" }}</div>
{% elif refresh_active %}
<div class="big">—</div><div class="note">Energía final pendiente · estimación no disponible</div>
{% else %}
<div class="big">—</div><div class="note">Sin energía final verificada</div>
{% endif %}
</section>
<section class="card" id="transaction-soc" aria-label="Estado de carga"><div class="metric-label">Estado de carga (SoC)</div>
<div class="soc-values">
<div><span class="note">Inicial</span><span class="soc-start">{{ (transaction.soc_start|string ~ "%") if transaction.soc_start is defined and transaction.soc_start is not none else "—" }}</span></div>
<div><span class="note">{{ "Última muestra" if (transaction.soc_end is not defined or transaction.soc_end is none) and timeline_soc_end is not none else "Final / última lectura" }}</span><span class="soc-end">{{ (transaction.soc_end|string ~ "%") if transaction.soc_end is defined and transaction.soc_end is not none else ("%.1f"|format(timeline_soc_end) ~ "%") if timeline_soc_end is not none else "—" }}</span></div>
</div>
</section></div>

<section class="timeline-card" id="transaction-timeline" aria-label="Evolución temporal de la carga">
{% if timeline.points %}
<div class="timeline-grid">
{% if timeline_charts %}{% set chart = timeline_charts[0] %}
<article class="timeline-plot">
<h3>{{ chart.label }} ({{ chart.unit }})</h3>
<svg role="img" aria-label="{{ chart.label }}: {{ chart.dots|length }} muestras observadas, mínimo {{ '%.2f'|format(chart.min) }} y máximo {{ '%.2f'|format(chart.max) }} {{ chart.unit }}" viewBox="0 0 600 185">
<line class="axis" x1="30" y1="155" x2="580" y2="155"/>
<line class="axis" x1="30" y1="20" x2="30" y2="155"/>
{% for segment in chart.segments %}<line class="timeline-segment" x1="{{ segment.a.x }}" y1="{{ segment.a.y }}" x2="{{ segment.b.x }}" y2="{{ segment.b.y }}"/>{% endfor %}
{% for dot in chart.dots %}<circle cx="{{ dot.x }}" cy="{{ dot.y }}" r="4"><title>{% if chart.field == 'soc' %}{{ '%.1f'|format(dot.value) }}%{% else %}{{ '%.3f'|format(dot.value) }} kWh · {{ ('%.1f'|format(dot.soc)) ~ '%' if dot.soc is not none else '—' }}{% endif %}</title></circle>{% endfor %}
<text x="33" y="15" font-size="12" fill="currentColor">{{ '%.2f'|format(chart.max) }} {{ chart.unit }}</text>
<text x="33" y="174" font-size="12" fill="currentColor">{{ '%.2f'|format(chart.min) }} {{ chart.unit }}</text>
</svg>
</article>
{% endif %}
</div>
{% else %}
<p class="timeline-empty">Historial de mediciones no disponible para esta sesión. Se conservan los totales y métricas verificados arriba; no se genera una curva estimada.</p>
{% endif %}
<div class="timeline-evidence" tabindex="0" aria-label="Tabla de mediciones verificadas"><table>
<thead><tr><th>Observada</th><th>Energía sesión (kWh)</th>{% if timeline_has_power %}<th>Potencia (kW)</th>{% endif %}{% if timeline_available.soc %}<th>SoC (%)</th>{% endif %}<th>Voltaje (V)</th><th>Corriente (A)</th><th>Ofrecida (A)</th><th>Temp. (°C)</th></tr></thead>
<tbody>{% for point in timeline.points %}<tr>
<td>{{ point.at|display_date(timezone) }}</td>
<td>{{ '%.3f'|format(point.energy_kwh) if point.energy_kwh is not none else '—' }}</td>
{% if timeline_has_power %}<td>{{ '%.3f'|format(point.power_kw) if point.power_kw is not none else '—' }}</td>{% endif %}
{% if timeline_available.soc %}<td>{{ '%.1f'|format(point.soc) if point.soc is not none else '—' }}</td>{% endif %}
<td>{{ '%.1f'|format(point.voltage_v) if point.voltage_v is not none else '' }}</td>
<td>{{ '%.2f'|format(point.current_import_a) if point.current_import_a is not none else '' }}</td>
<td>{{ '%.2f'|format(point.current_offered_a) if point.current_offered_a is not none else '' }}</td>
<td>{{ '%.1f'|format(point.temperature_c) if point.temperature_c is not none else '' }}</td>
</tr>{% endfor %}</tbody></table></div>
{% if timeline.discontinuous %}<p class="stale" role="status">Discontinuidad del medidor detectada: se suspende la curva de energía posterior al reinicio o caída del contador.</p>{% endif %}
{% if timeline.limited %}<p class="note">Vista parcial: se aplicó el límite de lectura/muestras; no se garantiza cobertura histórica completa.</p>{% endif %}
</section>
<section class="card session-details" id="transaction-session-data"><h2>Datos de la sesión</h2><dl>
<div><dt>Origen</dt><dd>{{ transaction.source_id }}</dd></div>
<div><dt>Tarjeta RFID</dt><dd>{{ transaction.rfid|e if transaction.rfid is string and transaction.rfid|trim else "—" }}</dd></div>
<div><dt>Inicio</dt><dd>{{ transaction.started_at|display_date(timezone) }}</dd></div>
<div><dt>Fin</dt><dd>{{ transaction.stopped_at|display_date(timezone) if transaction.stopped_at else "Activa / sin cierre" }}</dd></div>
<div><dt>{{ "Duración transcurrida (aprox.)" if refresh_active else "Duración final" }}</dt><dd>{{ elapsed_duration if refresh_active else transaction.started_at|session_duration(transaction.stopped_at) if transaction.stopped_at else "—" }}</dd></div>
<div><dt>Zona horaria</dt><dd>{{ timezone }}</dd></div>
</dl></section>
</main>
<script>
(() => {
  const root = document.querySelector("main[data-transaction-detail]");
  if (!root || root.dataset.active !== "true") return;
  let refreshing = false;
  const refreshTransaction = async () => {
    if (refreshing || document.hidden) return;
    refreshing = true;
    try {
      const response = await fetch(window.location.pathname + window.location.search, {
        credentials: "same-origin", cache: "no-store", headers: {"Accept": "text/html"}
      });
      if (!response.ok) return;
      const fresh = new DOMParser().parseFromString(await response.text(), "text/html");
      const nextRoot = fresh.querySelector("main[data-transaction-detail]");
      if (!nextRoot) return;
      // Preserve scroll, focused controls, and the back link; replace only data.
      for (const id of ["transaction-status", "transaction-energy", "transaction-soc",
                        "transaction-session-data", "transaction-timeline"]) {
        const current = document.getElementById(id);
        const next = fresh.getElementById(id);
        if (current && next && !current.contains(document.activeElement)
            && current.innerHTML !== next.innerHTML) current.innerHTML = next.innerHTML;
      }
      root.dataset.active = nextRoot.dataset.active;
      if (root.dataset.active !== "true") window.clearInterval(refreshTimer);
    } catch (_) {
      // A failed read must not disrupt a charging session or reload the page.
    } finally {
      refreshing = false;
    }
  };
  const refreshTimer = window.setInterval(refreshTransaction, 15000);
  window.addEventListener("pagehide", () => window.clearInterval(refreshTimer));
})();
</script>
</body></html>
