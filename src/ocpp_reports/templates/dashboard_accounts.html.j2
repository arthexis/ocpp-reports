<!doctype html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>Administrar cuentas · {{ title|e }}</title>
{% include "favicon_links.html.j2" %}
{% from "detail_header.html.j2" import detail_header %}
<style>
{% include "detail_header.css.j2" %}
{% include "detail_page.css.j2" %}
:root{--danger:#a61d33}
h2{font-size:1.05rem;margin:0 0 1rem}
h3{font-size:1rem;margin:.4rem 0}p{margin:.35rem 0 .9rem}.muted{color:var(--muted)}
.card{background:var(--surface);border:1px solid var(--line);border-radius:12px;margin-bottom:1.25rem;padding:1.25rem;box-shadow:0 2px 10px #152c4608}
.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem 1rem}
label:not(.checkbox){display:flex;flex-direction:column;gap:.3rem;font-size:.91rem;font-weight:600;min-width:0}
input:not([type=checkbox]),select{font:inherit;color:var(--ink);background:var(--surface);border:1px solid #98a8b9;border-radius:7px;min-height:44px;padding:.55rem;width:100%;max-width:100%}
input:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
button{border:0;border-radius:8px;background:var(--accent);color:#fff;min-height:44px;padding:.7rem 1rem;font:inherit;font-weight:650;cursor:pointer}
button.danger{background:var(--danger)}
a{color:var(--accent)}.action{margin-top:1rem;display:flex;gap:.7rem;align-items:center;flex-wrap:wrap}
.accounts{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:1rem;align-items:start}
.account-list{display:flex;flex-direction:column;gap:.25rem}
.account-list a{display:block;padding:.65rem .8rem;border-radius:7px;overflow-wrap:anywhere;text-decoration:none}
.account-list a:hover,.account-list a[aria-current="true"]{background:var(--bg);text-decoration:underline}
.account-list a[aria-current="true"]{font-weight:650}
.accounts .card{margin-bottom:0;min-width:0}
.alert{border-left:4px solid var(--danger);background:var(--surface);padding:.85rem 1rem;margin:0 0 1rem;border-radius:5px}
.notice{border-left:4px solid var(--accent);background:var(--surface);padding:.85rem 1rem;margin:0 0 1rem}
.danger-zone{border-top:1px solid var(--line);padding-top:.9rem;margin-top:1.2rem}
.checkbox{display:flex;align-items:flex-start;gap:.55rem;margin:.75rem 0;font-size:.9rem}
.checkbox input{margin-top:.3rem;accent-color:var(--danger)}
@media(max-width:760px){.fields,.accounts{grid-template-columns:1fr}.card{padding:1rem}}
@media(prefers-color-scheme:dark){:root{--danger:#ef6173}input:not([type=checkbox]),select{border-color:#63798d}button{color:#071320}}
</style></head>
<body>
{{ detail_header(title, '/', 'Dashboard', 'Administrar cuentas · Dashboard: ' ~ tenant ~ ' · Sesión: ' ~ actor, brand_image_url) }}
<main>
{% if error %}<div class="alert" role="alert">{{ error|e }}</div>{% endif %}
{% if notice %}<div class="notice" role="status">{{ notice|e }}</div>{% endif %}
<section class="card" aria-labelledby="new-account"><h2 id="new-account">Agregar cuenta</h2>
<form action="/accounts/create" method="post" autocomplete="off">
<input type="hidden" name="csrf_token" value="{{ csrf_token|e }}">
<div class="fields">
<label>Usuario<input name="username" required pattern="[A-Za-z][A-Za-z0-9._-]{2,63}" maxlength="64" placeholder="tecnologia" autocomplete="off"></label>
<label>Permisos<select name="role" required><option value="operator">Operador (solo lectura)</option><option value="admin">Administrador (edición)</option></select></label>
<label>Contraseña nueva<input type="password" name="password" required minlength="12" maxlength="1024" autocomplete="new-password"></label>
<label>Confirmar contraseña<input type="password" name="confirm_password" required minlength="12" maxlength="1024" autocomplete="new-password"></label>
</div><div class="action"><button type="submit">Crear cuenta</button></div>
</form><p class="muted">Mínimo 12 caracteres. El usuario solo puede pertenecer a un tenant; las contraseñas nunca se muestran después de guardarlas.</p>
</section>

<section aria-labelledby="existing-accounts"><h2 id="existing-accounts">Cuentas de {{ tenant|e }}</h2>
<div class="accounts">
<nav class="card account-list" aria-label="Usuarios">
{% for item in accounts %}
<a href="/accounts?user={{ item.user_id|urlencode }}" {% if selected_account and item.user_id == selected_account.user_id %}aria-current="true"{% endif %}>{{ item.user_id|e }}</a>
{% else %}
<p class="muted">Todavía no hay cuentas registradas en este tenant.</p>
{% endfor %}
</nav>
<article class="card" aria-label="Editar usuario">
{% if selected_account %}
{% set account = selected_account %}
<h3>{{ account.user_id|e }}</h3>
{% if account.user_id == actor %}
<a href="/change-password">Cambiar contraseña</a>
{% else %}
<form action="/accounts/update" method="post" autocomplete="off">
<input type="hidden" name="csrf_token" value="{{ csrf_token|e }}">
<input type="hidden" name="username" value="{{ account.user_id|e }}">
<div class="fields">
<label>Rol<select name="role" required>
<option value="operator" {% if account.role == 'operator' %}selected{% endif %}>Operador</option>
<option value="admin" {% if account.role == 'admin' %}selected{% endif %}>Administrador</option>
</select></label>
<label>Estado<select name="active" required><option value="1" {% if account.active %}selected{% endif %}>Activa</option>
<option value="0" {% if not account.active %}selected{% endif %}>Deshabilitada</option></select></label>
<label>Restablecer contraseña (opcional)<input type="password" name="password" minlength="12" maxlength="1024" autocomplete="new-password"></label>
<label>Confirmar contraseña nueva<input type="password" name="confirm_password" minlength="12" maxlength="1024" autocomplete="new-password"></label>
</div>
<p class="muted">Deja ambas contraseñas vacías para conservar la actual. El nombre del usuario no se modifica.</p>
<button type="submit">Guardar cambios</button>
</form>
<div class="danger-zone"><h3>Eliminar cuenta</h3>
<p class="muted">La eliminación es permanente y revoca las sesiones de esta cuenta. No afecta las sesiones OCPP.</p>
<form action="/accounts/delete" method="post">
<input type="hidden" name="csrf_token" value="{{ csrf_token|e }}">
<input type="hidden" name="username" value="{{ account.user_id|e }}">
<label class="checkbox"><input name="confirm" type="checkbox" value="ELIMINAR" required>
<span>Confirmo que quiero eliminar la cuenta <strong>{{ account.user_id|e }}</strong>.</span></label>
<button type="submit" class="danger">Eliminar cuenta</button>
</form></div>
{% endif %}
{% else %}
<p class="muted">Selecciona un usuario para editarlo</p>
{% endif %}
</article>
</div>
</section>
</main></body></html>
