<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Tarjeta RFID · {{ title }}</title>
{% include "favicon_links.html.j2" %}
{% from "detail_header.html.j2" import detail_header %}
<style>
{% include "detail_header.css.j2" %}
:root{color-scheme:light;--bg:#f5f7fa;--surface:#fff;--ink:#172437;--muted:#637286;--line:#e2e8f0;--nav:#203247;--accent:#1268c7;font:16px system-ui,sans-serif}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);line-height:1.45}a{color:var(--accent)}main{max-width:1320px;margin:auto;padding:1.25rem}section{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:1.25rem;margin-bottom:1rem}h1,h2{overflow-wrap:anywhere}h2{font-size:1.05rem;margin:0 0 1rem}.muted{color:var(--muted)}.scroll{overflow:auto}table{border-collapse:collapse;width:100%;font-size:.87rem}th,td{text-align:left;white-space:nowrap;padding:.75rem .65rem;border-bottom:1px solid var(--line)}th{font-weight:650;background:#f6f8fb;color:#34455a}tbody tr:last-child td{border-bottom:0}.numeric{text-align:right;font-variant-numeric:tabular-nums}svg{width:100%;min-width:440px;height:auto;color:var(--muted)}svg circle{fill:var(--accent)}svg text{fill:currentColor;font-size:12px}nav{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;margin-top:1rem}
@media(prefers-color-scheme:dark){:root{color-scheme:dark;--bg:#111923;--surface:#1b2734;--ink:#e8eef6;--muted:#a5b3c3;--line:#344557;--nav:#0c1520;--accent:#5da5f5}th{background:#263647;color:#d7e5f5}}
.status{display:inline-flex;align-items:center;gap:.4rem;border-radius:999px;padding:.2rem .5rem;font-size:.78rem;font-weight:650;background:#edf1f5}.status::before{content:"";width:.5rem;height:.5rem;border-radius:50%;background:#8795a7}.status--ok{background:#e3f6ed;color:#087342}.status--ok::before{background:#0b9960}.status--active{background:#e4f0ff;color:#155bad}.status--active::before{background:#1976e9}
@media(prefers-color-scheme:dark){.status{background:#354657;color:#e1e9f3}.status--ok{background:#164333;color:#9ce7c1}.status--active{background:#193c62;color:#a9d4ff}}
a:focus-visible,.scroll:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
{% include "page_geometry.css.j2" %}
</style></head><body>
{{ detail_header(title, '/?tz=' ~ (timezone|urlencode) ~ '#rfid-cards', 'Dashboard', 'Historial de tarjeta RFID · ' ~ timezone, brand_image_url) }}
<main>
<section><h1>{% if otros %}Otros{% else %}Tarjeta RFID: {{ rfid |e }}{% endif %}</h1>{% if otros %}<p class="muted">Sesiones sin RFID registrado.</p>{% endif %}<p>{{ result.counts.success }} cargas exitosas · {{ "%.2f"|format(energy_kwh) }} kWh · {{ result.total }} sesiones</p></section>
<section><h2>Energía acumulada (kWh)</h2><p class="muted">Cada punto suma el consumo final conocido de la sesión al total acumulado, en orden cronológico. Las sesiones sin energía final no aportan un valor ni un punto; el total puede ser parcial.</p>
<div class="scroll" tabindex="0"><svg viewBox="0 0 750 240" role="img" aria-label="Energía acumulada por sesión en kWh">
<path d="M65 25V205H710" fill="none" stroke="currentColor"/><text x="60" y="30" text-anchor="end">{{ "%.1f"|format(peak) }}</text><text x="60" y="205" text-anchor="end">0</text>
<polyline fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" points="{% for point in points if point.y is not none %}{{ point.x }},{{ point.y }} {% endfor %}"/>
{% for point in points %}{% if point.y is not none %}<circle cx="{{ point.x }}" cy="{{ point.y }}" r="4"><title>{{ point.at|display_date(timezone, seconds=true) }} · {{ point.charger_id |e }} #{{ point.id |e }} · {{ "%.2f"|format(point.kwh) }} kWh de sesión · {{ "%.2f"|format(point.cumulative_kwh) }} kWh acumulados</title></circle>{% endif %}{% endfor %}
<text x="65" y="230">Primera sesión</text><text x="710" y="230" text-anchor="end">Última sesión</text></svg></div></section>
<section><h2>Sesiones de carga</h2><div class="scroll" tabindex="0" role="region" aria-label="Sesiones de la tarjeta"><table><thead><tr><th>Ubicación</th><th>Cargador</th><th>Conector</th><th>ID</th><th>Estado</th><th>Inicio</th><th>Fin</th><th>Duración</th><th class="numeric">Energía (kWh)</th></tr></thead><tbody>
{% for t in result.transactions %}<tr><td>{{ (t.location or '—')|e }}</td><td><a href="/chargers/{{ t.source_id|urlencode }}/{{ t.charger_id|urlencode }}?tz={{ timezone|urlencode }}" aria-label="Ver cargador {{ t.charger_id|e }}">{{ t.charger_id|e }}</a></td><td>{% if t.connector_id is defined and t.connector_id is integer and t.connector_id >= 0 %}<a href="/connectors/{{ t.source_id|urlencode }}/{{ t.charger_id|urlencode }}/{{ t.connector_id }}?tz={{ timezone|urlencode }}" aria-label="Ver conector {{ t.connector_id }} del cargador {{ t.charger_id|e }}">{{ t.connector_id }}</a>{% else %}—{% endif %}</td><td><a href="/transactions/{{ t.source_id|urlencode }}/{{ t.charger_id|urlencode }}/{{ t.id |e }}?tz={{ timezone|urlencode }}">{{ t.id |e }}</a></td><td><span class="status {{ 'status--active' if (t.state or '')|lower in ['open', 'active', 'charging'] else 'status--ok' if (t.state or '')|lower in ['closed', 'stopped', 'completed'] else '' }}">{{ (t.state or 'Desconocido')|e }}</span></td><td>{{ t.started_at|display_date(timezone) }}</td><td>{{ t.stopped_at|display_date(timezone) if t.stopped_at else 'Sin cierre' }}</td><td>{{ t.started_at|session_duration(t.stopped_at) }}</td><td class="numeric">{{ "%.2f"|format(t.energy_wh / 1000) if t.energy_wh is number else '—' }}</td></tr>{% endfor %}
</tbody></table></div><nav aria-label="Páginas de sesiones">{% if result.page>1 %}<a rel="prev" href="{{ request.url.include_query_params(page=result.page-1)|e }}">Anterior</a>{% endif %}<span>Página {{ result.page }} de {{ result.pages }}</span>{% if result.page<result.pages %}<a rel="next" href="{{ request.url.include_query_params(page=result.page+1)|e }}">Siguiente</a>{% endif %}</nav></section>
</main></body></html>